---
import { getImage, Image } from "astro:assets";
import { stampItems } from "@/data/stamps";

const LIGHTBOX_MAX_WIDTH = 2400;
const THUMBNAIL_WIDTHS = [320, 480, 640, 960];

const galleryItems = await Promise.all(
	stampItems.map(async (stamp) => {
		const lightbox = await getImage({
			format: "webp",
			quality: 90,
			src: stamp.src,
			width: Math.min(stamp.src.width, LIGHTBOX_MAX_WIDTH),
		});

		return {
			...stamp,
			lightboxDetails: [
				stamp.countryOrRegion,
				stamp.issueDate,
				stamp.denomination,
				stamp.format,
				stamp.catalogue,
			]
				.filter(Boolean)
				.join(" · "),
			lightboxSrc: lightbox.src,
			thumbnailWidths: THUMBNAIL_WIDTHS.filter((width) => width <= stamp.src.width),
		};
	}),
);
---

<section class="section stamp-catalogue" data-alt-stamp-catalogue>
	<div class="wrap stamp-catalogue__inner">
		<div class="section-head">
			<h2>All stamps</h2>
			<p>{stampItems.length} pieces, each photographed front-on. Select one to see it larger.</p>
		</div>

		<ol aria-label="Stamp catalogue" class="stamp-grid">
			{
				galleryItems.map((stamp) => {
					return (
						<li class="stamp-card" data-alt-stamp-id={stamp.id} data-alt-stamp-item id={stamp.id}>
							<button
								aria-controls="alt-stamp-lightbox"
								aria-haspopup="dialog"
								aria-label={`Enlarge ${stamp.label}: ${stamp.caption}`}
								class="stamp-trigger"
								data-alt-stamp-alt={stamp.alt}
								data-alt-stamp-caption={stamp.caption}
								data-alt-stamp-details={stamp.lightboxDetails}
								data-alt-stamp-reference={stamp.referenceUrl}
								data-alt-stamp-src={stamp.lightboxSrc}
								data-alt-stamp-trigger
								type="button"
							>
								<span class="stamp-card__image-wrap">
									<Image
										alt={stamp.alt}
										class="stamp-card__image"
										decoding="async"
										format="webp"
										loading="lazy"
										quality={85}
										sizes="(min-width: 64rem) calc((min(100vw - 6rem, 86rem) - 3rem) / 3), (min-width: 40rem) calc((100vw - 4rem) / 2), calc(100vw - 2rem)"
										src={stamp.src}
										widths={stamp.thumbnailWidths}
									/>
								</span>
								<span class="stamp-card__details">
									<span class="stamp-card__label">{stamp.label}</span>
									<strong>{stamp.caption}</strong>
									<span class="stamp-card__meta">
										<span>{stamp.countryOrRegion}</span>
										<span>{stamp.issueDate}</span>
									</span>
									<span class="stamp-card__facts">
										<span>
											<span>Value</span>
											<span>{stamp.denomination}</span>
										</span>
										<span>
											<span>Photographed</span>
											<span>{stamp.format}</span>
										</span>
										{stamp.contents && (
											<span>
												<span>Contents</span>
												<span>{stamp.contents}</span>
											</span>
										)}
										{stamp.catalogue && (
											<span>
												<span>Catalogue</span>
												<span>{stamp.catalogue}</span>
											</span>
										)}
									</span>
								</span>
							</button>
						</li>
					);
				})
			}
		</ol>

		<div class="stamp-catalogue__note">
			<p>
				Continue through the visual archive in the <a href="/film/">film archive</a>.
			</p>
			<span aria-hidden="true" class="stamp-catalogue__rule"></span>
			<p class="meta">{stampItems.length} pieces</p>
		</div>
	</div>
</section>

<div aria-hidden="true" class="stamp-lightbox" data-alt-stamp-modal hidden id="alt-stamp-lightbox">
	<section
		aria-describedby="alt-stamp-lightbox-caption"
		aria-labelledby="alt-stamp-lightbox-title"
		aria-modal="true"
		class="stamp-lightbox__dialog"
		data-alt-stamp-dialog
		role="dialog"
		tabindex="-1"
	>
		<h2 class="stamp-visually-hidden" id="alt-stamp-lightbox-title">Enlarged stamp photograph</h2>
		<button
			aria-label="Close enlarged stamp photograph"
			class="stamp-lightbox__close"
			data-alt-stamp-close
			type="button"
		>
			<span aria-hidden="true"></span>
			<span>Close</span>
		</button>
		<figure>
			<div class="stamp-lightbox__image-wrap">
				<img alt="" data-alt-stamp-active />
			</div>
			<figcaption id="alt-stamp-lightbox-caption">
				<strong data-alt-stamp-caption></strong>
				<span data-alt-stamp-details></span>
				<a data-alt-stamp-reference-link hidden rel="noreferrer" target="_blank">
					Issue reference <span aria-hidden="true">↗</span>
				</a>
			</figcaption>
		</figure>
	</section>
</div>

<style>
	.stamp-catalogue {
		padding-top: clamp(2rem, 5vw, 3rem);
	}

	.stamp-catalogue__heading {
		display: grid;
		gap: 2rem;
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.stamp-catalogue__heading h2 {
		margin-top: 0.75rem;
	}

	.stamp-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
		padding: 0;
		list-style: none;
	}

	.stamp-card {
		min-width: 0;
	}

	.stamp-trigger {
		display: flex;
		width: 100%;
		height: 100%;
		flex-direction: column;
		margin: 0;
		padding: 0;
		border: 1px solid var(--rule-strong);
		appearance: none;
		background: var(--surface);
		color: var(--ink);
		cursor: zoom-in;
		text-align: left;
		transition:
			transform 200ms var(--ease),
			box-shadow 200ms var(--ease);
	}

	.stamp-trigger:hover,
	.stamp-trigger:focus-visible {
		box-shadow: 0 0 0 1px var(--signal);
	}

	.stamp-card__image-wrap {
		display: flex;
		width: 100%;
		aspect-ratio: 4 / 3;
		align-items: center;
		justify-content: center;
		padding: clamp(0.5rem, 1.2vw, 0.9rem);
		overflow: hidden;
		border-bottom: 1px solid var(--rule);
		background: var(--paper);
	}

	.stamp-card__image-wrap :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
		filter: saturate(0.9) contrast(1.02);
		transition: filter 200ms ease;
	}

	.stamp-trigger:hover .stamp-card__image-wrap :global(img),
	.stamp-trigger:focus-visible .stamp-card__image-wrap :global(img) {
		filter: saturate(1) contrast(1.01);
	}

	.stamp-card__details {
		display: flex;
		min-height: 15.5rem;
		flex: 1;
		flex-direction: column;
		padding: 1rem;
	}

	.stamp-card__label,
	.stamp-card__meta {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.07em;
		line-height: 1.45;
		text-transform: uppercase;
	}

	.stamp-card__label {
		color: var(--signal-ink);
	}

	.stamp-card__details strong {
		margin-top: 0.65rem;
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.35;
	}

	.stamp-card__meta {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: baseline;
		gap: 1rem;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--rule);
		color: var(--ink-3);
	}

	.stamp-card__meta span:last-child:not(:first-child) {
		text-align: right;
	}

	.stamp-card__facts {
		display: grid;
		gap: 0.55rem;
		margin-top: 0.8rem;
		font-size: 0.75rem;
		line-height: 1.4;
	}

	.stamp-card__facts > span {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr);
		gap: 0.75rem;
	}

	.stamp-card__facts > span > span:first-child {
		color: var(--ink-3);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.stamp-catalogue__note {
		display: grid;
		gap: 1.5rem;
		align-items: center;
		padding-top: 1.5rem;
		border-top: 1px solid var(--ink);
	}

	.stamp-catalogue__note > p:first-child {
		max-width: 42rem;
		font-size: clamp(1rem, 2vw, 1.25rem);
		line-height: 1.6;
	}

	.stamp-catalogue__note a {
		border-bottom: 1px solid currentColor;
		font-weight: 500;
	}

	.stamp-catalogue__note a:hover {
		color: var(--signal-ink);
	}

	.stamp-catalogue__rule {
		display: none;
		height: 1px;
		background: var(--rule);
	}

	.stamp-lightbox[hidden] {
		display: none;
	}

	.stamp-lightbox {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: grid;
		place-items: center;
		padding: clamp(0.75rem, 2vw, 2rem);
		background: rgb(4 15 31 / 96%);
		cursor: zoom-out;
	}

	.stamp-lightbox__dialog {
		position: relative;
		display: flex;
		width: min(100%, 96rem);
		max-height: 100%;
		flex-direction: column;
		cursor: default;
	}

	.stamp-lightbox__dialog:focus {
		outline: 0;
	}

	.stamp-lightbox__close {
		display: inline-flex;
		min-height: 3rem;
		align-self: flex-end;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
		padding: 0.65rem 0.9rem;
		border: 1px solid #fff;
		background: transparent;
		color: #fff;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
	}

	.stamp-lightbox__close:hover {
		background: var(--signal-fill);
		color: #fff;
	}

	.stamp-lightbox__close > span:first-child {
		position: relative;
		display: block;
		width: 1rem;
		height: 1rem;
	}

	.stamp-lightbox__close > span:first-child::before,
	.stamp-lightbox__close > span:first-child::after {
		position: absolute;
		top: 50%;
		left: 0;
		width: 100%;
		height: 1px;
		background: currentColor;
		content: "";
	}

	.stamp-lightbox__close > span:first-child::before {
		transform: rotate(45deg);
	}

	.stamp-lightbox__close > span:first-child::after {
		transform: rotate(-45deg);
	}

	.stamp-lightbox figure {
		display: flex;
		min-height: 0;
		flex: 1;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.stamp-lightbox__image-wrap {
		display: flex;
		min-height: 0;
		flex: 1;
		align-items: center;
		justify-content: center;
	}

	.stamp-lightbox__image-wrap img {
		display: block;
		max-width: 100%;
		max-height: calc(100svh - 9rem);
		object-fit: contain;
	}

	.stamp-lightbox figcaption {
		display: flex;
		width: min(100%, 72rem);
		min-height: 2rem;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: center;
		gap: 0.35rem 0.9rem;
		padding-top: 0.75rem;
		color: #c8d3e0;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-align: center;
		text-transform: uppercase;
	}

	.stamp-lightbox figcaption strong {
		font-weight: 600;
	}

	.stamp-lightbox figcaption > span {
		color: rgb(249 247 239 / 72%);
	}

	.stamp-lightbox figcaption a {
		border-bottom: 1px solid currentColor;
		color: #a6c8ff;
	}

	.stamp-lightbox figcaption a:hover,
	.stamp-lightbox figcaption a:focus-visible {
		color: #fff;
	}

	.stamp-visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (min-width: 40rem) {
		.stamp-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 48rem) {
		.stamp-catalogue__note {
			grid-template-columns: minmax(0, 7fr) 1px minmax(14rem, 3fr);
		}

		.stamp-catalogue__rule {
			display: block;
			width: 1px;
			height: 100%;
		}
	}

	@media (min-width: 64rem) {
		.stamp-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 39.99rem) {
		.stamp-lightbox {
			padding: 0.75rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.stamp-lightbox:not([hidden]) .stamp-lightbox__dialog {
			animation: stamp-lightbox-in 260ms var(--ease) both;
		}

		.stamp-lightbox__image-wrap img {
			transition: filter 300ms ease-out;
		}

		.stamp-lightbox__image-wrap img.is-loading {
			filter: blur(14px);
		}

		@keyframes stamp-lightbox-in {
			from {
				opacity: 0;
				transform: scale(0.975);
			}
			to {
				opacity: 1;
				transform: scale(1);
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.stamp-trigger {
			transition: none;
		}

		.stamp-trigger:hover,
		.stamp-trigger:focus-visible {
			transform: none;
		}
	}
</style>

<script>
	const modal = document.querySelector<HTMLElement>("[data-alt-stamp-modal]");
	const dialog = modal?.querySelector<HTMLElement>("[data-alt-stamp-dialog]");
	const activeImage = modal?.querySelector<HTMLImageElement>("[data-alt-stamp-active]");
	const caption = modal?.querySelector<HTMLElement>("[data-alt-stamp-caption]");
	const details = modal?.querySelector<HTMLElement>("[data-alt-stamp-details]");
	const referenceLink = modal?.querySelector<HTMLAnchorElement>("[data-alt-stamp-reference-link]");
	const closeButton = modal?.querySelector<HTMLButtonElement>("[data-alt-stamp-close]");
	const triggers = document.querySelectorAll<HTMLButtonElement>("[data-alt-stamp-trigger]");

	if (modal && dialog && activeImage && caption && details && referenceLink && closeButton) {
		let activeTrigger: HTMLButtonElement | null = null;
		let previousBodyOverflow = "";
		let scrollIsLocked = false;
		let loadVersion = 0;
		const preloads = new Map<string, HTMLImageElement>();

		const isOpen = () => !modal.hidden;

		const lockScroll = () => {
			if (scrollIsLocked) return;
			previousBodyOverflow = document.body.style.overflow;
			document.body.style.overflow = "hidden";
			scrollIsLocked = true;
		};

		const restoreScroll = () => {
			if (!scrollIsLocked) return;
			document.body.style.overflow = previousBodyOverflow;
			scrollIsLocked = false;
		};

		const warm = (trigger: HTMLButtonElement) => {
			const src = trigger.dataset.altStampSrc;
			if (!src || preloads.has(src)) return;
			const image = new Image();
			image.src = src;
			preloads.set(src, image);
		};

		const open = (trigger: HTMLButtonElement) => {
			const highResolutionSrc = trigger.dataset.altStampSrc ?? "";
			const thumbnail = trigger.querySelector<HTMLImageElement>("img");
			const thumbnailSrc =
				thumbnail?.currentSrc || thumbnail?.getAttribute("src") || highResolutionSrc;
			const version = ++loadVersion;

			activeTrigger = trigger;
			activeImage.src = thumbnailSrc;
			activeImage.alt = trigger.dataset.altStampAlt ?? "";
			activeImage.classList.toggle(
				"is-loading",
				Boolean(highResolutionSrc && thumbnailSrc !== highResolutionSrc),
			);
			caption.textContent = trigger.dataset.altStampCaption ?? "";
			details.textContent = trigger.dataset.altStampDetails ?? "";
			const referenceUrl = trigger.dataset.altStampReference;
			if (referenceUrl) {
				referenceLink.href = referenceUrl;
				referenceLink.hidden = false;
			} else {
				referenceLink.removeAttribute("href");
				referenceLink.hidden = true;
			}
			modal.hidden = false;
			modal.setAttribute("aria-hidden", "false");
			lockScroll();
			window.requestAnimationFrame(() => {
				if (isOpen()) closeButton.focus();
			});

			if (!highResolutionSrc || thumbnailSrc === highResolutionSrc) return;

			const fullSizeImage = preloads.get(highResolutionSrc) ?? new Image();
			fullSizeImage.src = highResolutionSrc;
			preloads.set(highResolutionSrc, fullSizeImage);
			const reveal = () => {
				if (version !== loadVersion || !isOpen()) return;
				activeImage.src = highResolutionSrc;
				activeImage.classList.remove("is-loading");
			};
			fullSizeImage.decode().then(reveal).catch(reveal);
		};

		const close = ({ restoreFocus = true } = {}) => {
			if (!isOpen()) {
				restoreScroll();
				return;
			}

			++loadVersion;
			modal.hidden = true;
			modal.setAttribute("aria-hidden", "true");
			activeImage.removeAttribute("src");
			activeImage.alt = "";
			activeImage.classList.remove("is-loading");
			caption.textContent = "";
			details.textContent = "";
			referenceLink.removeAttribute("href");
			referenceLink.hidden = true;
			restoreScroll();

			const triggerToRestore = activeTrigger;
			activeTrigger = null;
			if (restoreFocus && triggerToRestore?.isConnected) triggerToRestore.focus();
		};

		const getFocusableElements = () =>
			Array.from(
				dialog.querySelectorAll<HTMLElement>(
					'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
				),
			).filter((element) => !element.hasAttribute("hidden"));

		triggers.forEach((trigger) => {
			trigger.addEventListener("pointerenter", () => warm(trigger), { passive: true });
			trigger.addEventListener("focus", () => warm(trigger));
			trigger.addEventListener("click", () => open(trigger));
		});

		closeButton.addEventListener("click", () => close());

		modal.addEventListener("click", (event) => {
			if (event.target === modal || event.target === dialog) close();
		});

		document.addEventListener("keydown", (event) => {
			if (!isOpen()) return;

			if (event.key === "Escape") {
				event.preventDefault();
				close();
				return;
			}

			if (event.key !== "Tab") return;
			const focusableElements = getFocusableElements();
			if (focusableElements.length === 0) {
				event.preventDefault();
				dialog.focus();
				return;
			}

			const first = focusableElements[0];
			const last = focusableElements.at(-1);
			const focusIsOutsideSequence = !focusableElements.includes(
				document.activeElement as HTMLElement,
			);
			if (event.shiftKey && (document.activeElement === first || focusIsOutsideSequence)) {
				event.preventDefault();
				last?.focus();
			} else if (!event.shiftKey && (document.activeElement === last || focusIsOutsideSequence)) {
				event.preventDefault();
				first?.focus();
			}
		});

		window.addEventListener("pagehide", () => close({ restoreFocus: false }));
		document.addEventListener("astro:before-swap", () => close({ restoreFocus: false }));
	}
</script>
