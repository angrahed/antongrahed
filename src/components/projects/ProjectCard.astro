---
import { formatDay } from "@/lib/build-info";
import { languageBar, percentLabel, type Project, repoFor } from "@/lib/projects";

interface Props {
	headingLevel?: "h2" | "h3";
	project: Project;
}

const { headingLevel: Heading = "h3", project } = Astro.props;
const repo = repoFor(project);
const languages = languageBar(repo);
const install = project.snippets[0];
const updated = repo?.lastCommit?.date ?? repo?.pushedAt;
const version = repo?.latestRelease?.tag ?? repo?.latestTag ?? null;
---

<article class="pcard">
	<div class="pcard__head">
		<Heading class="pcard__title">
			<a href={`/projects/${project.slug}/`}>{project.title}</a>
		</Heading>
		{version && <span class="pcard__version mono">{version}</span>}
	</div>
	<p class="pcard__summary">{project.summary}</p>

	{
		languages.length > 0 && (
			<div class="pcard__languages">
				<div aria-hidden="true" class="langbar">
					{languages.map((language) => (
						<i data-lang-slot={language.slot} style={`flex: ${language.share} 1 0`} />
					))}
				</div>
				<ul aria-label="Languages" class="langs">
					{languages.map((language) => (
						<li>
							<i aria-hidden="true" class="lang-key" data-lang-slot={language.slot} />
							{language.name}
							<span class="num">{percentLabel(language.share)}</span>
						</li>
					))}
				</ul>
			</div>
		)
	}

	{
		install && (
			<pre
				aria-label={`${install.label} snippet`}
				class="pcard__snippet"
				set:text={install.code.split("\n").slice(0, 3).join("\n")}
			/>
		)
	}

	<dl class="pcard__facts">
		{
			repo && (
				<div>
					<dt>Commits</dt>
					<dd class="num">{repo.totalCommits}</dd>
				</div>
			)
		}
		{
			updated && (
				<div>
					<dt>Last commit</dt>
					<dd>{formatDay(updated)}</dd>
				</div>
			)
		}
		{
			repo?.license && (
				<div>
					<dt>Licence</dt>
					<dd>{repo.license}</dd>
				</div>
			)
		}
		{
			repo && repo.stars > 0 && (
				<div>
					<dt>Stars</dt>
					<dd class="num">{repo.stars}</dd>
				</div>
			)
		}
	</dl>
</article>

<style>
	.pcard {
		position: relative;
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 1rem;
		padding: clamp(1.25rem, 2.5vw, 1.75rem);
		background: var(--surface);
		transition: background-color 160ms var(--ease);
	}

	.pcard:hover {
		background: color-mix(in srgb, var(--surface) 70%, var(--surface-2));
	}

	.pcard__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.pcard__title {
		font-size: var(--step-2);
		font-weight: 450;
		letter-spacing: -0.02em;
	}

	.pcard__title a {
		text-decoration: none;
	}

	/* The whole card is the link target. */
	.pcard__title a::after {
		position: absolute;
		inset: 0;
		content: "";
	}

	.pcard__title a:focus-visible {
		outline: none;
	}

	.pcard:has(.pcard__title a:focus-visible) {
		outline: 2px solid var(--signal);
		outline-offset: -2px;
	}

	.pcard__version {
		color: var(--ink-3);
		font-size: var(--step--1);
	}

	.pcard__summary {
		max-width: 34rem;
		color: var(--ink-2);
	}

	.pcard__snippet {
		overflow: hidden;
		margin: 0;
		padding: 0.6rem 0.8rem;
		border-left: 2px solid var(--rule-strong);
		background: var(--paper);
		color: var(--ink-2);
		font-size: 0.78rem;
		line-height: 1.6;
		text-overflow: ellipsis;
		white-space: pre;
	}

	.pcard__facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		margin-top: auto;
		padding-top: 0.9rem;
		border-top: 1px solid var(--rule);
		font-size: var(--step--1);
	}

	.pcard__facts div {
		display: flex;
		gap: 0.4rem;
	}

	.pcard__facts dt {
		color: var(--ink-3);
	}

	.pcard__facts dd {
		margin: 0;
	}
</style>
