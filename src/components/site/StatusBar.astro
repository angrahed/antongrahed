---
import transition from "@/data/generated/transition.json";
import { buildInfo, formatDay } from "@/lib/build-info";

interface Props {
	section: string;
}

const { section } = Astro.props;
---

<aside aria-label="Site status" class="statusbar" data-statusbar>
	<div class="statusbar__progress" aria-hidden="true"></div>
	<div class="statusbar__inner">
		<p class="statusbar__item statusbar__section">
			<span aria-hidden="true" class="statusbar__dot"></span>
			<span data-status-section data-status-default={section}>{section}</span>
		</p>
		<p class="statusbar__item">
			World Bank WDI, updated {formatDay(transition.source.lastUpdated)}
		</p>
		<p class="statusbar__item statusbar__push">
			{
				buildInfo.sha ? (
					<>
						Build <span class="mono">{buildInfo.sha}</span>
						<span>{formatDay(buildInfo.builtAt)}</span>
					</>
				) : (
					<>Built {formatDay(buildInfo.builtAt)}</>
				)
			}
		</p>
		<p class="statusbar__item">
			London <time class="num" data-status-clock>--:--</time>
		</p>
		<button class="statusbar__item statusbar__button" data-palette-open type="button">
			<kbd class="kbd" data-mod-key>⌘K</kbd> Commands
		</button>
	</div>
</aside>

<style>
	.statusbar {
		display: none;
	}

	@media (min-width: 64rem) {
		.statusbar {
			position: fixed;
			right: 0;
			bottom: 0;
			left: 0;
			z-index: 40;
			display: block;
			height: var(--statusbar-h);
			border-top: 1px solid var(--rule);
			background: color-mix(in srgb, var(--surface) 92%, transparent);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
			color: var(--ink-3);
			font-size: 0.75rem;
			line-height: 1;
			view-transition-name: statusbar;
		}
	}

	.statusbar__inner {
		display: flex;
		height: 100%;
		align-items: stretch;
		padding-inline: 0.5rem;
	}

	.statusbar__item {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding-inline: 0.75rem;
		white-space: nowrap;
	}

	.statusbar__item + .statusbar__item {
		border-left: 1px solid var(--rule);
	}

	.statusbar__push {
		margin-left: auto;
	}

	.statusbar__push,
	.statusbar__push + .statusbar__item {
		border-left: 1px solid var(--rule);
	}

	.statusbar__section {
		color: var(--ink-2);
	}

	.statusbar__dot {
		width: 0.375rem;
		height: 0.375rem;
		border-radius: 50%;
		background: var(--signal);
	}

	.statusbar__button {
		border: 0;
		border-left: 1px solid var(--rule);
		background: transparent;
		color: inherit;
		font-size: inherit;
	}

	.statusbar__button:hover {
		background: var(--surface-2);
		color: var(--ink);
	}

	.statusbar .kbd {
		font-size: 0.6875rem;
		padding-block: 0;
	}

	/* Reading progress, driven by the scroll position where supported. */
	.statusbar__progress {
		position: absolute;
		top: -1px;
		left: 0;
		width: 100%;
		height: 1px;
		background: var(--signal);
		transform: scaleX(0);
		transform-origin: left;
	}

	@supports (animation-timeline: scroll()) {
		.statusbar__progress {
			animation: statusbar-progress linear both;
			animation-timeline: scroll(root block);
		}
	}

	@keyframes statusbar-progress {
		to {
			transform: scaleX(1);
		}
	}
</style>

<script>
	const label = document.querySelector<HTMLElement>("[data-status-section]");
	const clock = document.querySelector<HTMLTimeElement>("[data-status-clock]");

	if (clock) {
		const format = new Intl.DateTimeFormat("en-GB", {
			hour: "2-digit",
			minute: "2-digit",
			timeZone: "Europe/London",
		});
		const tick = () => {
			const now = new Date();
			clock.textContent = format.format(now);
			clock.dateTime = now.toISOString();
			window.setTimeout(tick, 60_000 - (now.getTime() % 60_000) + 50);
		};
		tick();
	}

	// Scroll-spy: name the tagged section that crosses the upper third of the viewport.
	const sections = Array.from(document.querySelectorAll<HTMLElement>("[data-section]"));
	if (label && sections.length > 0 && "IntersectionObserver" in window) {
		const fallback = label.dataset.statusDefault ?? "";
		const visible = new Set<HTMLElement>();
		const update = () => {
			const current = sections.filter((section) => visible.has(section)).at(-1);
			label.textContent = current?.dataset.section ?? fallback;
		};
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					const target = entry.target as HTMLElement;
					if (entry.isIntersecting) visible.add(target);
					else visible.delete(target);
				}
				update();
			},
			{ rootMargin: "-30% 0px -69% 0px" },
		);
		for (const section of sections) observer.observe(section);
	}
</script>
