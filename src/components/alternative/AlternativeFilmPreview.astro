---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import {
	FILM_PREVIEW_SLOTS,
	FILM_PREVIEW_STORAGE_KEY,
	type FilmPreviewOrientation,
	type FilmPreviewPool,
} from "@/components/alternative/filmPreviewSelection";

interface PreviewCandidate {
	alt: string;
	caption: string;
	height: number;
	id: string;
	isWide: boolean;
	orientation: FilmPreviewOrientation;
	src: string;
	srcset: string;
	width: number;
}

const filmModules = import.meta.glob<{ default: ImageMetadata }>(
	"../../assets/film/*.{jpg,jpeg,png,gif,webp,avif,JPG,JPEG,PNG,GIF,WEBP,AVIF}",
	{ eager: true },
);

const MAX_PREVIEW_WIDTH = 1440;
const PREVIEW_WIDTHS = [480, 640, 960, 1440];
const previewSizes = {
	architecture: "(min-width: 1024px) 50vw, (min-width: 704px) 54vw, calc(100vw - 2rem)",
	portrait: "(min-width: 1024px) 28vw, (min-width: 704px) 29vw, calc(100vw - 2rem)",
	wide: "(min-width: 1024px) 58vw, (min-width: 704px) 62vw, calc(100vw - 2rem)",
} as const;
const PREFERRED_FALLBACK_IDS = [
	"film-2026-07-paris-01",
	"film-2025-04-wasinki-park",
	"film-2025-04-cafe-moskau",
] as const;

const fallbackMetadata: Partial<Record<string, Pick<PreviewCandidate, "alt" | "caption">>> = {
	"film-2025-04-cafe-moskau": {
		alt: "Café Moskau in Berlin beneath a darkening sky",
		caption: "Berlin · 04/2025",
	},
	"film-2026-07-paris-08": {
		alt: "Passenger aircraft and two smaller aircraft crossing a pale sky over Paris",
		caption: "Paris · 07/2026",
	},
};

const formatLocation = (parts: string[]) => {
	const normalized = parts.join(" ").replace(/\d+$/, "").trim();
	const labels: Record<string, string> = { eu: "EU", lot: "LOT", moma: "MoMA" };
	return normalized
		.split(/\s+/)
		.filter(Boolean)
		.map((word) => labels[word.toLowerCase()] ?? `${word.charAt(0).toUpperCase()}${word.slice(1)}`)
		.join(" ");
};

const candidates = await Promise.all(
	Object.entries(filmModules)
		.sort(([left], [right]) => left.localeCompare(right))
		.map(async ([path, module]): Promise<PreviewCandidate> => {
			const filename = (path.split("/").pop() ?? "film-photo").replace(/\.[^/.]+$/, "");
			const id = `film-${filename
				.toLowerCase()
				.replace(/[^a-z0-9]+/g, "-")
				.replace(/^-|-$/g, "")}`;
			const parts = filename.split(/[-_]+/);
			const hasDate =
				parts.length > 2 && /^\d{4}$/.test(parts[0] ?? "") && /^\d{1,2}$/.test(parts[1] ?? "");
			const location = formatLocation(hasDate ? parts.slice(2) : parts) || "Untitled frame";
			const date = hasDate ? `${parts[1]?.padStart(2, "0")}/${parts[0]}` : "";
			const outputWidth = Math.min(module.default.width, MAX_PREVIEW_WIDTH);
			const widths = [
				...new Set([...PREVIEW_WIDTHS.filter((width) => width < outputWidth), outputWidth]),
			];
			const optimized = await getImage({
				format: "webp",
				quality: 85,
				src: module.default,
				width: outputWidth,
				widths,
			});
			const metadata = fallbackMetadata[id] ?? {
				alt: `Film photograph — ${location}`,
				caption: `${location}${date ? ` · ${date}` : ""}`,
			};

			return {
				...metadata,
				height: Number(optimized.attributes.height),
				id,
				isWide: module.default.width / module.default.height >= 1.25,
				orientation: module.default.height > module.default.width ? "portrait" : "landscape",
				src: optimized.src,
				srcset: optimized.srcSet.attribute,
				width: Number(optimized.attributes.width),
			};
		}),
);

if (new Set(candidates.map(({ id }) => id)).size !== candidates.length) {
	throw new Error("Film preview IDs must be unique.");
}

const usedFallbackIds = new Set<string>();
const pool: FilmPreviewPool = {
	landscape: candidates
		.filter(({ orientation }) => orientation === "landscape")
		.map(({ id }) => id),
	portrait: candidates.filter(({ orientation }) => orientation === "portrait").map(({ id }) => id),
	wide: candidates.filter(({ isWide }) => isWide).map(({ id }) => id),
};
const fallbackSelection = FILM_PREVIEW_SLOTS.map((slot, index) => {
	const preferredId = PREFERRED_FALLBACK_IDS[index];
	const preferred = candidates.find(
		(candidate) =>
			candidate.id === preferredId &&
			pool[slot.pool].includes(candidate.id) &&
			!usedFallbackIds.has(candidate.id),
	);
	const candidate =
		preferred ??
		candidates.find(
			(candidate) => pool[slot.pool].includes(candidate.id) && !usedFallbackIds.has(candidate.id),
		);

	if (!candidate)
		throw new Error(`No fallback from the ${slot.pool} pool is available for ${slot.id}.`);
	usedFallbackIds.add(candidate.id);
	return { candidate, slot };
});

const clientManifest = JSON.stringify({
	candidates,
	pool,
}).replaceAll("<", "\\u003c");
---

<div
	class="film-grid"
	data-alt-film-preview
	data-alt-film-preview-ready="false"
	data-alt-film-preview-storage-key={FILM_PREVIEW_STORAGE_KEY}
	data-alt-film-preview-total={candidates.length}
>
	{
		fallbackSelection.map(({ candidate, slot }) => (
			<figure
				class={`alt-photo-frame film-card film-card--${slot.id}`}
				data-alt-film-preview-id={candidate.id}
				data-alt-film-preview-item={candidate.id}
				data-alt-film-preview-slot={slot.id}
				data-reveal
			>
				<img
					alt={candidate.alt}
					class="film-card__image"
					data-alt-film-preview-image
					decoding="async"
					height={candidate.height}
					loading="lazy"
					sizes={previewSizes[slot.id]}
					src={candidate.src}
					srcset={candidate.srcset}
					width={candidate.width}
				/>
				<figcaption data-alt-film-preview-caption>{candidate.caption}</figcaption>
			</figure>
		))
	}
</div>

<script data-alt-film-preview-data is:inline set:html={clientManifest} type="application/json" />

<style>
	.film-grid {
		display: grid;
		gap: 1.5rem;
		margin-top: clamp(2.5rem, 6vw, 5rem);
	}

	.film-card {
		margin: 0;
		background: var(--alt-paper-raised);
	}

	.film-card__image {
		display: block;
		width: 100%;
		height: 100%;
		max-height: 42rem;
		object-fit: cover;
	}

	.film-card--wide .film-card__image {
		aspect-ratio: 3 / 2;
	}

	.film-card--portrait .film-card__image {
		aspect-ratio: 4 / 5;
	}

	.film-card--architecture .film-card__image {
		aspect-ratio: 4 / 3;
	}

	.film-card figcaption {
		display: flex;
		min-height: 2.5rem;
		align-items: center;
		justify-content: space-between;
		padding: 0 0.75rem;
		border-top: 1px solid var(--alt-line);
		font-family: var(--alt-font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	@media (min-width: 44rem) {
		.film-grid {
			grid-template-columns: repeat(12, minmax(0, 1fr));
			align-items: start;
		}

		.film-card--wide {
			grid-column: 1 / span 8;
		}

		.film-card--portrait {
			grid-column: 9 / -1;
			margin-top: 8rem;
		}

		.film-card--architecture {
			grid-column: 3 / span 7;
		}
	}
</style>

<script>
	import {
		FILM_PREVIEW_SLOTS,
		FILM_PREVIEW_STORAGE_KEY,
		selectFilmPreviewIds,
		type FilmPreviewPool,
	} from "@/components/alternative/filmPreviewSelection";

	interface ClientCandidate {
		alt: string;
		caption: string;
		height: number;
		id: string;
		src: string;
		srcset: string;
		width: number;
	}

	interface ClientManifest {
		candidates: ClientCandidate[];
		pool: FilmPreviewPool;
	}

	const preview = document.querySelector<HTMLElement>("[data-alt-film-preview]");
	const manifestElement = document.querySelector<HTMLScriptElement>("[data-alt-film-preview-data]");

	const renderRandomPreview = (root: HTMLElement, manifestText: string) => {
		try {
			const manifest = JSON.parse(manifestText) as ClientManifest;
			if (
				!Array.isArray(manifest.candidates) ||
				!Array.isArray(manifest.pool?.landscape) ||
				!Array.isArray(manifest.pool?.portrait) ||
				!Array.isArray(manifest.pool?.wide)
			) {
				return false;
			}

			const candidateById = new Map(
				manifest.candidates.map((candidate) => [candidate.id, candidate]),
			);
			let previousIds: string[] = [];
			let storage: Storage | undefined;

			try {
				storage = window.sessionStorage;
			} catch {
				storage = undefined;
			}
			if (storage) {
				try {
					const storedValue = storage.getItem(FILM_PREVIEW_STORAGE_KEY);
					const parsedValue = storedValue ? JSON.parse(storedValue) : [];
					if (Array.isArray(parsedValue) && parsedValue.every((id) => typeof id === "string")) {
						previousIds = parsedValue;
					}
				} catch {
					previousIds = [];
				}
			}

			const browserRandom = () => {
				if (window.crypto?.getRandomValues) {
					const value = new Uint32Array(1);
					window.crypto.getRandomValues(value);
					return (value[0] ?? 0) / 2 ** 32;
				}
				return Math.random();
			};
			const selectedIds = selectFilmPreviewIds(manifest.pool, browserRandom, previousIds);
			const items = [...root.querySelectorAll<HTMLElement>("[data-alt-film-preview-item]")];
			const renderItems = selectedIds.map((id, index) => {
				const item = items[index];
				return {
					candidate: candidateById.get(id),
					caption: item?.querySelector<HTMLElement>("[data-alt-film-preview-caption]"),
					image: item?.querySelector<HTMLImageElement>("[data-alt-film-preview-image]"),
					item,
				};
			});
			if (
				items.length !== FILM_PREVIEW_SLOTS.length ||
				renderItems.some(
					({ candidate, caption, image, item }) => !candidate || !caption || !image || !item,
				)
			) {
				return false;
			}

			for (const { candidate, caption, image, item } of renderItems) {
				if (!candidate || !caption || !image || !item) continue;
				item.dataset.altFilmPreviewId = candidate.id;
				item.dataset.altFilmPreviewItem = candidate.id;
				image.alt = candidate.alt;
				image.width = candidate.width;
				image.height = candidate.height;
				image.srcset = candidate.srcset;
				image.src = candidate.src;
				caption.textContent = candidate.caption;
			}

			try {
				storage?.setItem(FILM_PREVIEW_STORAGE_KEY, JSON.stringify(selectedIds));
			} catch {
				// The randomized preview still works when storage is unavailable.
			}
			return true;
		} catch {
			return false;
		}
	};

	if (preview && manifestElement?.textContent) {
		preview.dataset.altFilmPreviewReady = String(
			renderRandomPreview(preview, manifestElement.textContent),
		);
	}
</script>
