---
import {
	countLivingCells,
	createLifeScene,
	initialLifeAge,
	LIFE_SCENE_LENGTH,
	LIFE_SCENES,
	LIFE_SIZE,
	LIFE_STEP_MS,
} from "./life";

const initialBoard = createLifeScene(0);
const cellStates = ["newborn", "alive", "mature"] as const;
const cells = Array.from({ length: LIFE_SIZE * LIFE_SIZE }, (_, index) => {
	const row = Math.floor(index / LIFE_SIZE);
	const column = index % LIFE_SIZE;
	const alive = initialBoard[index] === 1;
	const tilt = (((index * 37 + row * 11) % 15) - 7) / 10;
	const scale = 0.965 + ((index * 19 + column * 7) % 8) / 200;
	return {
		column,
		row,
		state: alive ? cellStates[initialLifeAge(index) - 1] : "dead",
		style: `--life-tilt: ${tilt}deg; --life-scale: ${scale.toFixed(3)}`,
	};
});
---

<section aria-labelledby="life-hero-title" class="life-hero" data-life-hero>
	<div class="life-hero__scene">
		<div class="life-hero__inner">
			<div class="life-hero__copy">
				<p class="life-hero__eyebrow">
					<span aria-hidden="true"></span>
					Economist · EBRD Office of the Chief Economist
				</p>
				<h1 id="life-hero-title">
					Working on the economics of <span class="life-hero__ending"
						>transition.<span aria-hidden="true" class="life-hero__cursor"></span></span
					>
				</h1>
				<p class="life-hero__lead">
					Hi, I’m Anton Grahed. I research economic growth, development, and the economic legacy
					of communism at the European Bank for Reconstruction and Development.
				</p>
				<div class="life-hero__actions">
					<a class="life-hero__button life-hero__button--primary" href="/#about">
						<span>About me</span>
						<span aria-hidden="true">↘</span>
					</a>
					<a class="life-hero__button" href="/#projects">
						<span>View projects</span>
						<span aria-hidden="true">→</span>
					</a>
				</div>
			</div>

			<div class="life-hero__art-column">
				<div
					aria-hidden="true"
					class="life-grid"
					data-life-art
					data-life-board
					data-life-generation="0"
					data-life-live-count={countLivingCells(initialBoard)}
					data-life-ready="false"
					data-life-running="false"
					data-life-scene="0"
					data-life-scene-count={LIFE_SCENES.length}
					data-life-scene-length={LIFE_SCENE_LENGTH}
					data-life-size={LIFE_SIZE}
					data-life-step={LIFE_STEP_MS}
					id="life-grid"
				>
					{
						cells.map((cell) => (
							<span
								class="life-grid__cell"
								data-column={cell.column}
								data-life-cell
								data-row={cell.row}
								data-state={cell.state}
								style={cell.style}
							/>
						))
					}
				</div>
				<button
					aria-controls="life-grid"
					class="life-toggle"
					data-life-toggle
					data-life-paused="true"
					hidden
					type="button"
				>
					<span aria-hidden="true" class="life-toggle__mark"></span>
					<span data-life-toggle-label>Play evolution</span>
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	import {
		countLivingCells,
		createLifeScene,
		evolveLife,
		initialLifeAge,
		LIFE_SCENES,
		LIFE_SCENE_LENGTH,
		LIFE_STEP_MS,
		LIFE_TRANSITION_MS,
	} from "./life";

	type MotionChoice = "paused" | "playing" | null;

	const lifeHeroes = document.querySelectorAll<HTMLElement>("[data-life-hero]");

	for (const root of lifeHeroes) {
		if (root.dataset.lifeInitialized === "true") continue;

		const boardElement = root.querySelector<HTMLElement>("[data-life-board]");
		const cellElements = boardElement
			? Array.from(boardElement.querySelectorAll<HTMLElement>("[data-life-cell]"))
			: [];
		const toggle = root.querySelector<HTMLButtonElement>("[data-life-toggle]");
		const toggleLabel = toggle?.querySelector<HTMLElement>("[data-life-toggle-label]");
		if (!boardElement || !toggle || !toggleLabel || cellElements.length === 0) continue;

		root.dataset.lifeInitialized = "true";
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
		let board = createLifeScene(0);
		let ages = new Uint8Array(board.length);
		let scene = 0;
		let generation = 0;
		let inView = false;
		let timer = 0;
		let animationFrame = 0;
		let transitioning = false;
		let destroyed = false;
		let motionChoice: MotionChoice = null;
		let observer: IntersectionObserver | undefined;

		const resetAges = () => {
			ages = new Uint8Array(board.length);
			for (let index = 0; index < board.length; index += 1) {
				if (board[index] === 1) ages[index] = initialLifeAge(index);
			}
		};

		const motionWanted = () => {
			if (motionChoice === "paused") return false;
			if (motionChoice === "playing") return true;
			return !reducedMotion.matches;
		};

		const canRun = () =>
			!destroyed && inView && document.visibilityState === "visible" && motionWanted();

		const syncToggle = () => {
			const paused = !motionWanted();
			toggle.dataset.lifePaused = paused.toString();
			toggleLabel.textContent = paused ? "Play evolution" : "Pause evolution";
		};

		const stateFor = (index: number) => {
			if (board[index] !== 1) return "dead";
			if ((ages[index] ?? 0) <= 1) return "newborn";
			if (ages[index] === 2) return "alive";
			return "mature";
		};

		const render = () => {
			for (let index = 0; index < cellElements.length; index += 1) {
				const state = stateFor(index);
				if (cellElements[index]?.dataset.state !== state) {
					cellElements[index]?.setAttribute("data-state", state);
				}
			}
			boardElement.dataset.lifeScene = String(scene);
			boardElement.dataset.lifeGeneration = String(generation);
			boardElement.dataset.lifeLiveCount = String(countLivingCells(board));
		};

		const clearScheduledWork = () => {
			if (timer !== 0) window.clearTimeout(timer);
			if (animationFrame !== 0) window.cancelAnimationFrame(animationFrame);
			timer = 0;
			animationFrame = 0;
		};

		const stop = () => {
			clearScheduledWork();
			transitioning = false;
			boardElement.classList.remove("is-transitioning");
			boardElement.dataset.lifeRunning = "false";
		};

		const updateAges = (nextBoard: Uint8Array) => {
			const nextAges = new Uint8Array(ages.length);
			for (let index = 0; index < nextBoard.length; index += 1) {
				if (nextBoard[index] !== 1) continue;
				nextAges[index] = board[index] === 1 ? Math.min(3, (ages[index] ?? 0) + 1) : 1;
			}
			ages = nextAges;
		};

		const schedule = () => {
			if (!canRun() || timer !== 0 || animationFrame !== 0 || transitioning) return;
			boardElement.dataset.lifeRunning = "true";
			timer = window.setTimeout(() => {
				timer = 0;
				animationFrame = window.requestAnimationFrame(advance);
			}, LIFE_STEP_MS);
		};

		const changeScene = () => {
			if (!canRun() || transitioning) return;
			transitioning = true;
			boardElement.classList.add("is-transitioning");
			timer = window.setTimeout(() => {
				timer = 0;
				if (!canRun()) {
					stop();
					return;
				}
				scene = (scene + 1) % LIFE_SCENES.length;
				generation = 0;
				board = createLifeScene(scene);
				resetAges();
				render();
				animationFrame = window.requestAnimationFrame(() => {
					animationFrame = 0;
					transitioning = false;
					boardElement.classList.remove("is-transitioning");
					schedule();
				});
			}, LIFE_TRANSITION_MS);
		};

		function advance() {
			animationFrame = 0;
			if (!canRun()) {
				stop();
				return;
			}
			if (generation >= LIFE_SCENE_LENGTH) {
				changeScene();
				return;
			}

			const nextBoard = evolveLife(board);
			updateAges(nextBoard);
			board = nextBoard;
			generation += 1;
			render();
			schedule();
		}

		const reconcile = () => {
			if (canRun()) schedule();
			else stop();
			syncToggle();
		};

		const handleVisibility = () => reconcile();
		const handleMotionPreference = () => reconcile();
		const handlePageShow = (event: PageTransitionEvent) => {
			if (event.persisted) reconcile();
		};
		const handlePageHide = (event: PageTransitionEvent) => {
			if (event.persisted) stop();
			else cleanup();
		};
		const cleanup = () => {
			if (destroyed) return;
			destroyed = true;
			stop();
			observer?.disconnect();
			reducedMotion.removeEventListener("change", handleMotionPreference);
			document.removeEventListener("visibilitychange", handleVisibility);
			window.removeEventListener("pagehide", handlePageHide);
			window.removeEventListener("pageshow", handlePageShow);
		};

		toggle.addEventListener("click", () => {
			motionChoice = motionWanted() ? "paused" : "playing";
			reconcile();
		});
		reducedMotion.addEventListener("change", handleMotionPreference);
		document.addEventListener("visibilitychange", handleVisibility);
		window.addEventListener("pagehide", handlePageHide);
		window.addEventListener("pageshow", handlePageShow);
		document.addEventListener("astro:before-swap", cleanup, { once: true });

		resetAges();
		render();
		boardElement.dataset.lifeReady = "true";
		toggle.hidden = false;
		syncToggle();

		if ("IntersectionObserver" in window) {
			observer = new IntersectionObserver(
				(entries) => {
					inView = entries.some((entry) => entry.isIntersecting);
					reconcile();
				},
				{ threshold: 0.08 },
			);
			observer.observe(boardElement);
		} else {
			inView = true;
			reconcile();
		}
	}
</script>

<style>
	.life-hero {
		--life-paper: #edf7fb;
		--life-paper-deep: #dceff7;
		--life-navy: #062845;
		--life-deep: #074b84;
		--life-cobalt: #1268d8;
		--life-azure: #2d9df0;
		--life-ink: #061d32;
		position: relative;
		isolation: isolate;
		overflow: clip;
		color: var(--life-ink);
		background: var(--life-paper);
		font-family: "IBM Plex Sans", ui-sans-serif, system-ui, sans-serif;
	}

	.life-hero__scene {
		display: flex;
		min-height: min(62rem, calc(100svh - 3rem));
		align-items: center;
	}

	.life-hero__inner {
		display: grid;
		width: min(100% - 4rem, 105rem);
		margin-inline: auto;
		grid-template-columns: minmax(23rem, 0.86fr) minmax(32rem, 1.14fr);
		gap: clamp(3rem, 6vw, 8rem);
		align-items: center;
	}

	.life-hero__copy {
		position: relative;
		z-index: 2;
		padding-block: 5rem;
	}

	.life-hero__eyebrow {
		display: flex;
		max-width: 34rem;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0 1.5rem;
		color: var(--life-cobalt);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: clamp(0.66rem, 0.8vw, 0.76rem);
		font-weight: 500;
		line-height: 1.5;
		letter-spacing: 0.11em;
		text-transform: uppercase;
	}

	.life-hero__eyebrow span {
		width: 1.8rem;
		height: 0.45rem;
		background: var(--life-cobalt);
	}

	.life-hero h1 {
		max-width: 12ch;
		margin: 0;
		font-size: clamp(3.25rem, 5.25vw, 6.7rem);
		font-weight: 450;
		line-height: 0.92;
		letter-spacing: -0.066em;
		text-wrap: balance;
	}

	.life-hero__ending {
		white-space: nowrap;
	}

	.life-hero__cursor {
		display: inline-block;
		width: 0.5em;
		height: 0.76em;
		margin-left: 0.12em;
		background: var(--life-cobalt);
		vertical-align: -0.04em;
		animation: life-cursor-blink 900ms steps(1, end) infinite;
	}

	@keyframes life-cursor-blink {
		0%,
		48% {
			opacity: 1;
		}

		49%,
		100% {
			opacity: 0;
		}
	}

	.life-hero__lead {
		max-width: 38rem;
		margin: 2rem 0 0;
		color: rgb(6 29 50 / 76%);
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: clamp(0.9rem, 1.1vw, 1.05rem);
		line-height: 1.72;
	}

	.life-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 2.25rem;
	}

	.life-hero__button {
		display: inline-flex;
		min-width: 10.75rem;
		min-height: 3.25rem;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
		border: 1px solid var(--life-navy);
		padding: 0.75rem 1rem;
		color: var(--life-navy);
		background: transparent;
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			background-color 140ms ease,
			color 140ms ease;
	}

	.life-hero__button--primary,
	.life-hero__button:hover {
		color: var(--life-paper);
		background: var(--life-navy);
	}

	.life-hero__button--primary:hover {
		background: var(--life-cobalt);
	}

	.life-hero__button:focus-visible,
	.life-toggle:focus-visible {
		outline: 3px solid var(--life-cobalt);
		outline-offset: 4px;
	}

	.life-hero__art-column {
		display: grid;
		width: min(100%, 42rem);
		justify-self: center;
		gap: 1.1rem;
	}

	.life-grid {
		display: grid;
		width: 100%;
		aspect-ratio: 1;
		grid-template-columns: repeat(25, minmax(0, 1fr));
		gap: clamp(2px, 0.4vw, 6px);
		contain: layout paint style;
		transition: opacity 280ms ease;
	}

	.life-grid.is-transitioning {
		opacity: 0.12;
	}

	.life-grid__cell {
		min-width: 0;
		aspect-ratio: 1;
		background: rgb(18 104 216 / 5%);
		opacity: 0.72;
		transform: rotate(var(--life-tilt)) scale(var(--life-scale));
		transform-origin: center;
		transition:
			background-color 210ms ease,
			box-shadow 210ms ease,
			opacity 210ms ease,
			transform 210ms ease;
	}

	.life-grid__cell[data-state="newborn"] {
		background: var(--life-azure);
		box-shadow: 0.11rem 0.14rem 0 rgb(6 40 69 / 10%);
		opacity: 1;
		transform: rotate(var(--life-tilt)) scale(calc(var(--life-scale) * 0.9));
	}

	.life-grid__cell[data-state="alive"] {
		background: var(--life-cobalt);
		box-shadow: 0.11rem 0.14rem 0 rgb(6 40 69 / 11%);
		opacity: 1;
	}

	.life-grid__cell[data-state="mature"] {
		background: var(--life-deep);
		box-shadow: 0.11rem 0.14rem 0 rgb(6 40 69 / 12%);
		opacity: 1;
	}

	.life-toggle {
		display: inline-flex;
		min-height: 2.75rem;
		align-items: center;
		justify-self: end;
		gap: 0.65rem;
		border: 1px solid var(--life-navy);
		padding: 0.55rem 0.8rem;
		color: var(--life-navy);
		background: transparent;
		font-family: "IBM Plex Mono", ui-monospace, monospace;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		cursor: pointer;
	}

	.life-toggle[hidden] {
		display: none;
	}

	.life-toggle:hover {
		background: var(--life-paper-deep);
	}

	.life-toggle__mark {
		display: block;
		width: 0.65rem;
		height: 0.65rem;
		background: var(--life-cobalt);
	}

	.life-toggle[data-life-paused="false"] .life-toggle__mark {
		background: repeating-linear-gradient(
			90deg,
			var(--life-cobalt) 0 0.2rem,
			transparent 0.2rem 0.34rem
		);
	}

	@media (max-width: 79.99rem) and (min-width: 64rem) {
		.life-hero__inner {
			width: min(100% - 3rem, 105rem);
			grid-template-columns: minmax(21rem, 0.88fr) minmax(30rem, 1.12fr);
			gap: 2.5rem;
		}

		.life-hero h1 {
			font-size: clamp(3.5rem, 5.15vw, 5rem);
		}
	}

	@media (max-width: 63.99rem) {
		.life-hero__scene {
			min-height: 0;
			padding: 5rem 0 4rem;
		}

		.life-hero__inner {
			width: min(100% - 2rem, 50rem);
			grid-template-columns: 1fr;
			gap: 1rem;
		}

		.life-hero__copy {
			padding: 0 0 3rem;
		}

		.life-hero h1 {
			max-width: 11ch;
			font-size: clamp(3.1rem, 11vw, 6rem);
		}

		.life-hero__lead {
			max-width: 42rem;
		}

		.life-hero__art-column {
			width: min(100%, 32rem);
		}
	}

	@media (max-width: 37.49rem) {
		.life-hero__scene {
			padding-top: 4rem;
		}

		.life-hero__inner {
			width: min(100% - 1.5rem, 32rem);
		}

		.life-hero h1 {
			font-size: clamp(2.8rem, 14vw, 4.6rem);
		}

		.life-hero__eyebrow {
			max-width: 27rem;
		}

		.life-hero__lead {
			font-size: 0.86rem;
			line-height: 1.65;
		}

		.life-hero__actions {
			display: grid;
			grid-template-columns: 1fr;
		}

		.life-hero__button {
			width: 100%;
		}

		.life-hero__art-column {
			width: min(100%, 27rem);
		}

		.life-grid {
			gap: 2px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.life-hero__cursor {
			animation: none;
		}

		.life-grid,
		.life-grid__cell,
		.life-hero__button {
			transition: none;
		}
	}
</style>
