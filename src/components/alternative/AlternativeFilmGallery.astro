---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const filmModules = import.meta.glob<{ default: ImageMetadata }>(
	"../../assets/film/*.{jpg,jpeg,png,gif,webp,avif,JPG,JPEG,PNG,GIF,WEBP,AVIF}",
	{ eager: true },
);

const LIGHTBOX_MAX_WIDTH = 3200;
const GALLERY_MAX_WIDTH = 1216;
const DISPLAY_DENSITY = 2;
const THUMBNAIL_WIDTHS = [480, 768, 1024, 1536, 2048];

const galleryImages = await Promise.all(
	Object.entries(filmModules)
		.sort(([a], [b]) => a.localeCompare(b))
		.map(async ([path, mod], index) => {
			const filename = (path.split("/").pop() ?? "film-photo").replace(/\.[^/.]+$/, "");
			const parts = filename.split(/[-_]+/);
			const hasDate =
				parts.length > 2 && /^\d{4}$/.test(parts[0] ?? "") && /^\d{1,2}$/.test(parts[1] ?? "");
			const location = (hasDate ? parts.slice(2) : parts)
				.join(" ")
				.replace(/(\d+)$/, " $1")
				.trim();
			const date = hasDate ? `${parts[1]?.padStart(2, "0")}/${parts[0]}` : "";
			const frame = String(index + 1).padStart(2, "0");
			const lightboxWidth = Math.min(mod.default.width, LIGHTBOX_MAX_WIDTH);
			const displayWidth = Math.min(
				GALLERY_MAX_WIDTH,
				Math.floor(mod.default.width / DISPLAY_DENSITY),
			);
			const saturationViewport = Math.ceil(displayWidth / 0.94);
			const sizes = `(min-width: ${saturationViewport}px) ${displayWidth}px, (min-width: 534px) 94vw, calc(100vw - 2rem)`;
			const srcsetMaxWidth = Math.min(mod.default.width, GALLERY_MAX_WIDTH * DISPLAY_DENSITY);
			const thumbnailWidths = [
				...new Set([...THUMBNAIL_WIDTHS, displayWidth, srcsetMaxWidth]),
			]
				.filter((width) => width <= srcsetMaxWidth)
				.sort((left, right) => left - right);

			const lightbox = await getImage({
				format: "jpg",
				quality: "max",
				src: mod.default,
				width: lightboxWidth,
			});

			return {
				alt: `Film photograph — ${location}`,
				caption: `Frame ${frame} · ${location}`,
				date,
				displayWidth,
				lightboxSrc: lightbox.src,
				sizes,
				src: mod.default,
				thumbnailWidths,
			};
		}),
);
---

<section class="film-hero alt-section alt-section--blue">
	<div class="alt-shell film-hero__inner">
		<p class="alt-kicker">Archive · 35mm</p>
		<h1>Shot on film</h1>
		<p class="alt-lead">
			A rolling selection from my negatives. Near and far, mostly on a Nikon F5, Nikon FA,
			Nikon FM2N and an Olympus Mju II.
		</p>
		<p class="film-hero__count">{String(galleryImages.length).padStart(2, "0")} frames</p>
	</div>
</section>

<section class="film-archive alt-section">
	<div class="alt-shell film-archive__inner">
		<div class="film-archive__heading">
			<p class="alt-kicker">Contact sheet · Full archive</p>
			<p>Select any frame to inspect the full scan.</p>
		</div>

		{
			galleryImages.length === 0 ? (
				<div class="film-empty" role="status">
					<span aria-hidden="true"></span>
					<p class="alt-kicker">No frames loaded</p>
					<p>Fresh scans are on their way.</p>
				</div>
			) : (
				<div class="film-gallery" data-alt-film-gallery>
					{galleryImages.map(({ alt, caption, date, displayWidth, lightboxSrc, sizes, src, thumbnailWidths }) => (
						<article
							class="film-card"
							data-film-max-width={displayWidth}
							style={`--film-max-width: ${displayWidth}px`}
						>
							<button
								aria-controls="alt-film-lightbox"
								aria-haspopup="dialog"
								class="film-trigger"
								data-alt-film-alt={alt}
								data-alt-film-caption={`${caption}${date ? ` · ${date}` : ""}`}
								data-alt-film-src={lightboxSrc}
								data-alt-film-trigger
								type="button"
							>
								<span class="film-frame">
									<Image
										alt={alt}
										decoding="async"
										format="jpg"
										loading="lazy"
										quality="max"
										sizes={sizes}
										src={src}
										widths={thumbnailWidths}
									/>
								</span>
								<span class="film-card__caption">
									<span>{caption}</span>
									{date && <span>{date}</span>}
								</span>
							</button>
						</article>
					))}
				</div>
			)
		}
	</div>
</section>

<div
	aria-hidden="true"
	class="film-lightbox"
	data-alt-film-modal
	hidden
	id="alt-film-lightbox"
>
	<section
		aria-describedby="alt-film-lightbox-caption"
		aria-labelledby="alt-film-lightbox-title"
		aria-modal="true"
		class="film-lightbox__dialog"
		data-alt-film-dialog
		role="dialog"
		tabindex="-1"
	>
		<h2 class="film-visually-hidden" id="alt-film-lightbox-title">Enlarged film photograph</h2>
		<button
			aria-label="Close enlarged photograph"
			class="film-lightbox__close"
			data-alt-film-close
			type="button"
		>
			<span aria-hidden="true"></span>
			<span>Close</span>
		</button>
		<figure>
			<div class="film-lightbox__image-wrap">
				<img alt="" data-alt-film-active />
			</div>
			<figcaption data-alt-film-caption id="alt-film-lightbox-caption"></figcaption>
		</figure>
	</section>
</div>

<style>
	.film-hero {
		position: relative;
		overflow: hidden;
		border-top: 0;
	}

	.film-hero__inner {
		position: relative;
		z-index: 1;
		display: grid;
		min-height: min(44rem, calc(100svh - 3rem));
		align-content: end;
		padding-block: clamp(7rem, 15vw, 13rem) clamp(3rem, 6vw, 5rem);
	}

	.film-hero h1 {
		max-width: 8ch;
		margin-top: 0.75rem;
		font-size: clamp(4.5rem, 13vw, 12rem);
		font-weight: 300;
		letter-spacing: -0.075em;
		line-height: 0.82;
	}

	.film-hero .alt-lead {
		max-width: 43rem;
		margin-top: clamp(2rem, 5vw, 4rem);
	}

	.film-hero__count {
		position: absolute;
		right: clamp(1rem, 3vw, 3rem);
		bottom: clamp(3rem, 6vw, 5rem);
		font-family: var(--alt-font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.film-archive__inner {
		padding-block: clamp(4rem, 8vw, 8rem);
	}

	.film-archive__heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--alt-ink);
	}

	.film-archive__heading > p:last-child {
		max-width: 24rem;
		color: var(--alt-ink-muted);
		font-size: 0.875rem;
		text-align: right;
	}

	.film-gallery {
		display: flex;
		width: min(100%, 76rem);
		flex-direction: column;
		gap: clamp(4.5rem, 8vw, 8rem);
		margin-inline: auto;
		padding-block: clamp(4rem, 8vw, 8rem);
	}

	.film-card {
		position: relative;
		width: min(100%, var(--film-max-width, 76rem));
		align-self: center;
		margin: 0;
	}

	.film-trigger {
		position: relative;
		display: block;
		width: 100%;
		margin: 0;
		padding: 0;
		border: 0;
		appearance: none;
		background: transparent;
		color: var(--alt-ink);
		cursor: zoom-in;
		text-align: left;
	}

	.film-frame {
		display: block;
		overflow: hidden;
		border: 1px solid var(--alt-ink);
		background: var(--alt-paper-deep);
		box-shadow: 0.75rem 0.9rem 0 rgb(7 26 51 / 11%);
	}

	.film-frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
		filter: saturate(0.86) contrast(1.04);
		transition: filter 280ms ease;
	}

	.film-trigger:hover .film-frame :global(img),
	.film-trigger:focus-visible .film-frame :global(img) {
		filter: saturate(1) contrast(1.02);
	}

	.film-card__caption {
		display: flex;
		min-height: 2.75rem;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 0 0;
		border-top: 1px solid var(--alt-ink);
		font-family: var(--alt-font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.07em;
		line-height: 1.45;
		text-transform: uppercase;
	}

	.film-card__caption span:last-child {
		flex: 0 0 auto;
		color: var(--alt-ink-muted);
	}

	.film-empty {
		display: grid;
		min-height: 24rem;
		place-content: center;
		justify-items: center;
		gap: 0.5rem;
		margin-block: clamp(4rem, 8vw, 8rem);
		border: 1px solid var(--alt-ink);
		background: var(--alt-paper-raised);
		text-align: center;
	}

	.film-empty > span {
		display: block;
		width: 6rem;
		height: 4rem;
		margin-bottom: 1rem;
		border: 1rem solid var(--alt-sky);
		border-radius: 50%;
	}

	.film-lightbox[hidden] {
		display: none;
	}

	.film-lightbox {
		position: fixed;
		inset: 0;
		z-index: 200;
		display: grid;
		place-items: center;
		padding: clamp(0.75rem, 2vw, 2rem);
		background: rgb(4 15 31 / 96%);
		cursor: zoom-out;
	}

	.film-lightbox__dialog {
		position: relative;
		display: flex;
		width: min(100%, 96rem);
		max-height: 100%;
		flex-direction: column;
		cursor: default;
	}

	.film-lightbox__dialog:focus {
		outline: 0;
	}

	.film-lightbox__close {
		display: inline-flex;
		min-height: 3rem;
		align-self: flex-end;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
		padding: 0.65rem 0.9rem;
		border: 1px solid var(--alt-white);
		background: transparent;
		color: var(--alt-white);
		font-family: var(--alt-font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		cursor: pointer;
	}

	.film-lightbox__close:hover {
		background: var(--alt-sky);
		color: var(--alt-ink);
	}

	.film-lightbox__close > span:first-child {
		position: relative;
		display: block;
		width: 1rem;
		height: 1rem;
	}

	.film-lightbox__close > span:first-child::before,
	.film-lightbox__close > span:first-child::after {
		position: absolute;
		top: 50%;
		left: 0;
		width: 100%;
		height: 1px;
		background: currentColor;
		content: "";
	}

	.film-lightbox__close > span:first-child::before {
		transform: rotate(45deg);
	}

	.film-lightbox__close > span:first-child::after {
		transform: rotate(-45deg);
	}

	.film-lightbox figure {
		display: flex;
		min-height: 0;
		flex: 1;
		flex-direction: column;
		align-items: center;
		justify-content: center;
	}

	.film-lightbox__image-wrap {
		display: flex;
		min-height: 0;
		flex: 1;
		align-items: center;
		justify-content: center;
	}

	.film-lightbox__image-wrap img {
		display: block;
		max-width: 100%;
		max-height: calc(100svh - 9rem);
		object-fit: contain;
	}

	.film-lightbox figcaption {
		width: 100%;
		min-height: 2rem;
		padding-top: 0.75rem;
		color: var(--alt-paper-deep);
		font-family: var(--alt-font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.08em;
		text-align: center;
		text-transform: uppercase;
	}

	.film-visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (max-width: 43.99rem) {
		.film-hero__inner {
			min-height: 38rem;
		}

		.film-hero__count {
			position: static;
			margin-top: 2rem;
		}

		.film-archive__heading {
			align-items: start;
			flex-direction: column;
			gap: 0.75rem;
		}

		.film-archive__heading > p:last-child {
			text-align: left;
		}

		.film-gallery {
			gap: 4.5rem;
		}

		.film-lightbox {
			padding: 0.75rem;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.film-lightbox:not([hidden]) .film-lightbox__dialog {
			animation: film-lightbox-in 260ms var(--alt-ease-out) both;
		}

		.film-lightbox__image-wrap img {
			transition: filter 300ms ease-out;
		}

		.film-lightbox__image-wrap img.is-loading {
			filter: blur(14px);
		}

		@keyframes film-lightbox-in {
			from {
				opacity: 0;
				transform: scale(0.975);
			}
			to {
				opacity: 1;
				transform: scale(1);
			}
		}
	}

</style>

<script>
	const modal = document.querySelector<HTMLElement>("[data-alt-film-modal]");
	const dialog = modal?.querySelector<HTMLElement>("[data-alt-film-dialog]");
	const activeImage = modal?.querySelector<HTMLImageElement>("[data-alt-film-active]");
	const caption = modal?.querySelector<HTMLElement>("[data-alt-film-caption]");
	const closeButton = modal?.querySelector<HTMLButtonElement>("[data-alt-film-close]");
	const triggers = document.querySelectorAll<HTMLButtonElement>("[data-alt-film-trigger]");

	if (modal && dialog && activeImage && caption && closeButton) {
		let activeTrigger: HTMLButtonElement | null = null;
		let previousBodyOverflow = "";
		let scrollIsLocked = false;
		let loadVersion = 0;
		const preloads = new Map<string, HTMLImageElement>();

		const isOpen = () => !modal.hidden;

		const lockScroll = () => {
			if (scrollIsLocked) return;
			previousBodyOverflow = document.body.style.overflow;
			document.body.style.overflow = "hidden";
			scrollIsLocked = true;
		};

		const restoreScroll = () => {
			if (!scrollIsLocked) return;
			document.body.style.overflow = previousBodyOverflow;
			scrollIsLocked = false;
		};

		const warm = (trigger: HTMLButtonElement) => {
			const src = trigger.dataset.altFilmSrc;
			if (!src || preloads.has(src)) return;
			const image = new Image();
			image.src = src;
			preloads.set(src, image);
		};

		const open = (trigger: HTMLButtonElement) => {
			const highResolutionSrc = trigger.dataset.altFilmSrc ?? "";
			const thumbnail = trigger.querySelector<HTMLImageElement>("img");
			const thumbnailSrc =
				thumbnail?.currentSrc || thumbnail?.getAttribute("src") || highResolutionSrc;
			const version = ++loadVersion;

			activeTrigger = trigger;
			activeImage.src = thumbnailSrc;
			activeImage.alt = trigger.dataset.altFilmAlt ?? "";
			activeImage.classList.toggle(
				"is-loading",
				Boolean(highResolutionSrc && thumbnailSrc !== highResolutionSrc),
			);
			caption.textContent = trigger.dataset.altFilmCaption ?? "";
			modal.hidden = false;
			modal.setAttribute("aria-hidden", "false");
			lockScroll();
			window.requestAnimationFrame(() => {
				if (isOpen()) closeButton.focus();
			});

			if (!highResolutionSrc || thumbnailSrc === highResolutionSrc) return;

			const fullSizeImage = preloads.get(highResolutionSrc) ?? new Image();
			fullSizeImage.src = highResolutionSrc;
			preloads.set(highResolutionSrc, fullSizeImage);
			const reveal = () => {
				if (version !== loadVersion || !isOpen()) return;
				activeImage.src = highResolutionSrc;
				activeImage.classList.remove("is-loading");
			};
			fullSizeImage.decode().then(reveal).catch(reveal);
		};

		const close = ({ restoreFocus = true } = {}) => {
			if (!isOpen()) {
				restoreScroll();
				return;
			}

			++loadVersion;
			modal.hidden = true;
			modal.setAttribute("aria-hidden", "true");
			activeImage.removeAttribute("src");
			activeImage.alt = "";
			activeImage.classList.remove("is-loading");
			caption.textContent = "";
			restoreScroll();

			const triggerToRestore = activeTrigger;
			activeTrigger = null;
			if (restoreFocus && triggerToRestore?.isConnected) triggerToRestore.focus();
		};

		const getFocusableElements = () =>
			Array.from(
				dialog.querySelectorAll<HTMLElement>(
					'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
				),
			).filter((element) => !element.hasAttribute("hidden"));

		triggers.forEach((trigger) => {
			trigger.addEventListener("pointerenter", () => warm(trigger), { passive: true });
			trigger.addEventListener("focus", () => warm(trigger));
			trigger.addEventListener("click", () => open(trigger));
		});

		closeButton.addEventListener("click", () => close());

		modal.addEventListener("click", (event) => {
			if (event.target === modal || event.target === dialog) close();
		});

		document.addEventListener("keydown", (event) => {
			if (!isOpen()) return;

			if (event.key === "Escape") {
				event.preventDefault();
				close();
				return;
			}

			if (event.key !== "Tab") return;
			const focusableElements = getFocusableElements();
			if (focusableElements.length === 0) {
				event.preventDefault();
				dialog.focus();
				return;
			}

			const first = focusableElements[0];
			const last = focusableElements.at(-1);
			const focusIsOutsideSequence = !focusableElements.includes(
				document.activeElement as HTMLElement,
			);
			if (event.shiftKey && (document.activeElement === first || focusIsOutsideSequence)) {
				event.preventDefault();
				last?.focus();
			} else if (!event.shiftKey && (document.activeElement === last || focusIsOutsideSequence)) {
				event.preventDefault();
				first?.focus();
			}
		});

		window.addEventListener("pagehide", () => close({ restoreFocus: false }));
		document.addEventListener("astro:before-swap", () => close({ restoreFocus: false }));
	}
</script>
