---
interface NavItem {
	activePath?: string;
	href: string;
	label: string;
}

const normalizePath = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalizePath(Astro.url.pathname);

const navItems: NavItem[] = [
	{ activePath: "/", href: "/", label: "Home" },
	{ href: "/#about", label: "About" },
	{ href: "/#projects", label: "Projects" },
	{ activePath: "/film", href: "/film/", label: "Film" },
	{ activePath: "/stamps", href: "/stamps/", label: "Stamps" },
	{ href: "/#books", label: "Books" },
];
---

<header class="alt-header">
	<div class="alt-header__inner">
		<a class="alt-brand" href="/" aria-label="Anton Grahed — home">
			<span aria-hidden="true" class="alt-rect-mark">
				<i></i><i></i><i></i>
			</span>
			<span class="alt-brand__name">Anton Grahed</span>
		</a>

		<nav aria-label="Primary navigation" class="alt-header__nav">
			{
				navItems.map((item) => (
					<a aria-current={item.activePath === currentPath ? "page" : undefined} href={item.href}>
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>
