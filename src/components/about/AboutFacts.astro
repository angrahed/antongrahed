---
/** Three plain facts under a rule that draws itself in when the row appears. */
const facts = [
	{ label: "Now", value: "Research Analyst, Office of the Chief Economist, EBRD" },
	{ label: "Studied", value: "BSc and MSc in Economics, London School of Economics" },
	{ label: "Works in", value: "Julia, R, Stata and Python" },
];
---

<div class="about-facts" data-facts>
	<span aria-hidden="true" class="about-facts__rule"></span>
	<dl>
		{
			facts.map((fact, index) => (
				<div class="about-facts__item" style={`--i: ${index}`}>
					<dt>{fact.label}</dt>
					<dd>{fact.value}</dd>
				</div>
			))
		}
	</dl>
</div>

<style>
	.about-facts {
		position: relative;
		container-type: inline-size;
		padding-top: 1rem;
	}

	.about-facts__rule {
		position: absolute;
		top: 0;
		right: 0;
		left: 0;
		height: 1px;
		background: var(--rule-strong);
		transform-origin: left;
	}

	.about-facts dl {
		display: grid;
		gap: 1rem 2rem;
		margin: 0;
	}

	.about-facts__item {
		margin: 0;
	}

	.about-facts dt {
		color: var(--ink-3);
		font-size: var(--step--1);
	}

	.about-facts dd {
		margin: 0.25rem 0 0;
		line-height: 1.5;
	}

	@container (min-width: 40rem) {
		.about-facts dl {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	/* Armed by the script: the rule draws left to right, then the facts follow it in. */
	.about-facts.is-armed .about-facts__rule {
		transform: scaleX(0);
		transition: transform 1100ms cubic-bezier(0.65, 0, 0.15, 1);
	}

	.about-facts.is-armed .about-facts__item {
		opacity: 0;
		transform: translateY(0.4rem);
		transition:
			opacity 600ms var(--ease) calc(350ms + var(--i) * 140ms),
			transform 700ms var(--ease) calc(350ms + var(--i) * 140ms);
	}

	.about-facts.is-armed.is-in .about-facts__rule {
		transform: none;
	}

	.about-facts.is-armed.is-in .about-facts__item {
		opacity: 1;
		transform: none;
	}
</style>

<script>
	const rows = document.querySelectorAll<HTMLElement>("[data-facts]");
	const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
	if (!reduce && "IntersectionObserver" in window) {
		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					entry.target.classList.add("is-in");
					observer.unobserve(entry.target);
				}
			},
			{ threshold: 0.6 },
		);
		for (const row of rows) {
			const box = row.getBoundingClientRect();
			if (box.top < window.innerHeight && box.bottom > 0) continue;
			row.classList.add("is-armed");
			observer.observe(row);
		}
	}
</script>
