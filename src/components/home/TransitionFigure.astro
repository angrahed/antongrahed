---
import {
	binFor,
	countries,
	DEFAULT_MEASURE,
	DEFAULT_PINNED,
	figureTitle,
	lastIndexWithValue,
	lastYear,
	firstYear,
	benchmarkLabel,
	benchmarkOrder,
	DEFAULT_BENCHMARK,
	DEFAULT_FORM,
	medianSeries,
	measures,
	pathFor,
	position,
	regionNames,
	seriesFor,
	sourceLine,
	tabLabel,
	tabOrder,
	sparkPath,
	spreadLabels,
	tableRows,
	tickLabelChars,
	tickPositions,
	valueAt,
	VIEWBOX,
	xPosition,
	xTicks,
	years,
} from "@/lib/transition";
import { TILE_COLUMNS, TILE_ROWS } from "@/data/transition-countries";

const measure = measures[DEFAULT_MEASURE];
const yearIndex = years.length - 1;
const series = seriesFor(measure.id);
const median = medianSeries(measure.id);
const pinned = DEFAULT_PINNED.map((iso3, index) => ({
	country: countries.find((country) => country.iso3 === iso3),
	iso3,
	slot: index + 1,
}));
const yTicks = tickPositions(measure);
const endLabels = [
	...pinned.map(({ country, iso3, slot }) => {
		const s = series[iso3] ?? [];
		const index = lastIndexWithValue(s);
		const value = s[index];
		return {
			key: iso3,
			label: country?.name ?? iso3,
			pos: value == null ? null : position(measure, value),
			slot,
		};
	}),
	(() => {
		const index = lastIndexWithValue(median);
		const value = median[index];
		return {
			key: "median",
			label: "Median",
			pos: value == null ? null : position(measure, value),
			slot: 0,
		};
	})(),
];
// Converging lines: nudge the labels apart (the client redoes this at the plot's real height).
const labelled = endLabels.filter((label) => label.pos != null);
const spread = spreadLabels(
	labelled.map((label) => label.pos ?? 0),
	0.065,
);
const visibleLabels = labelled.map((label, index) => ({
	...label,
	pos: spread[index] ?? label.pos ?? 0,
}));
const readout = pinned.map(({ country, iso3, slot }) => ({
	iso3,
	name: country?.name ?? iso3,
	slot,
	value: valueAt(measure.id, iso3, yearIndex),
}));
const medianNow = median[yearIndex] ?? null;
const rows = tableRows(measure, yearIndex);
---

<figure
	aria-labelledby="tfig-title"
	class="instrument tfig"
	data-kind={measure.kind}
	data-section="Figure 1"
	data-tfig
	id="figure-1"
>
	<header class="tfig__head">
		<p class="tfig__title">
			<span class="figure-label">Figure 1</span>
			<span data-tfig-title id="tfig-title">{figureTitle(measure)}</span>
		</p>
		<div aria-label="Display" class="tfig__view" role="group">
			<button aria-pressed="true" class="tfig__view-button" data-tfig-view="chart" type="button"
				>Chart</button
			>
			<button aria-pressed="false" class="tfig__view-button" data-tfig-view="table" type="button"
				>Table</button
			>
		</div>
	</header>

	<div class="tfig__controls">
		<div aria-label="Measure" class="tfig__tabs" data-tfig-tabs role="tablist">
			{
				tabOrder.map((tab, index) => (
					<button
						aria-controls="tfig-panel"
						aria-selected={tab === measure.tabId ? "true" : "false"}
						class="tfig__tab"
						data-tfig-tab={tab}
						role="tab"
						tabindex={tab === measure.tabId ? 0 : -1}
						title={`${tabLabel[tab]} (key ${index + 1})`}
						type="button"
					>
						{tabLabel[tab]}
					</button>
				))
			}
		</div>
		<div class="tfig__time">
			<button aria-label="Replay from 1990" class="tfig__play" data-tfig-play type="button">
				<svg aria-hidden="true" class="tfig__play-icon" viewBox="0 0 12 12">
					<path d="M3 1.5v9l7.5-4.5Z" fill="currentColor"></path>
				</svg>
				<svg aria-hidden="true" class="tfig__pause-icon" viewBox="0 0 12 12">
					<path d="M3 1.5h2v9H3zM7 1.5h2v9H7z" fill="currentColor"></path>
				</svg>
			</button>
			<input
				aria-label="Year"
				class="tfig__range"
				data-tfig-year
				max={lastYear}
				min={firstYear}
				step="1"
				type="range"
				value={lastYear}
			/>
			<output class="tfig__year num" data-tfig-year-label>{lastYear}</output>
		</div>
	</div>

	<div class="tfig__sub" data-tfig-sub hidden>
		<div aria-label="Convergence view" class="tfig__seg" role="group">
			<button
				aria-pressed={DEFAULT_FORM === "gap" ? "true" : "false"}
				data-tfig-form="gap"
				type="button">Gap over time</button
			>
			<button
				aria-pressed={DEFAULT_FORM === "catchup" ? "true" : "false"}
				data-tfig-form="catchup"
				type="button">Catch-up</button
			>
		</div>
		<div aria-label="Benchmark" class="tfig__seg" role="group">
			<span class="tfig__seg-label">Against</span>
			{
				benchmarkOrder.map((benchmark) => (
					<button
						aria-pressed={benchmark === DEFAULT_BENCHMARK ? "true" : "false"}
						data-tfig-benchmark={benchmark}
						type="button"
					>
						{benchmarkLabel[benchmark]}
					</button>
				))
			}
		</div>
	</div>

	<div class="tfig__body" data-tfig-chart-view id="tfig-panel" role="tabpanel">
		<div class="tfig__chart">
			<ul aria-label="Compared economies" class="tfig__keys" data-tfig-keys role="list">
				{
					readout.map(({ iso3, name, slot, value }) => (
						<li class="tfig__key" data-iso={iso3} data-slot={slot}>
							<i aria-hidden="true" class="tfig__line-key" />
							<span class="tfig__key-name">{name}</span>
							<span class="tfig__key-value num">
								{value == null ? "No data" : measure.format(value)}
							</span>
							<button
								aria-label={`Stop comparing ${name}`}
								class="tfig__key-remove"
								data-tfig-unpin={iso3}
								type="button"
							>
								<svg aria-hidden="true" viewBox="0 0 10 10">
									<path d="m2 2 6 6M8 2 2 8" stroke="currentColor" stroke-width="1.4" />
								</svg>
							</button>
						</li>
					))
				}
				<li class="tfig__key tfig__key--median" data-iso="median">
					<i aria-hidden="true" class="tfig__line-key"></i>
					<span class="tfig__key-name"
						>Median<span class="tfig__unit"> of {countries.length}</span></span
					>
					<span class="tfig__key-value num"
						>{medianNow == null ? "No data" : measure.format(medianNow)}</span
					>
				</li>
			</ul>

			<div class="tfig__plot" data-tfig-plot style={`--ychars: ${tickLabelChars(measure)}`}>
				<div aria-hidden="true" class="tfig__yaxis" data-tfig-yaxis>
					{
						yTicks.map((tick) => (
							<span class="num" style={`bottom: ${(tick.pos * 100).toFixed(2)}%`}>
								{tick.label}
							</span>
						))
					}
				</div>
				<div class="tfig__canvas" data-tfig-canvas>
					<svg
						aria-hidden="true"
						class="tfig__grid"
						data-tfig-grid
						preserveAspectRatio="none"
						viewBox={`0 0 ${VIEWBOX} ${VIEWBOX}`}
					>
						{
							yTicks.map((tick) => {
								const y = ((1 - tick.pos) * VIEWBOX).toFixed(1);
								return (
									<line
										class:list={[tick.strong && "is-baseline"]}
										x1="0"
										x2={VIEWBOX}
										y1={y}
										y2={y}
									/>
								);
							})
						}
					</svg>
					<div class="tfig__ink" data-tfig-ink>
						<svg
							aria-hidden="true"
							preserveAspectRatio="none"
							viewBox={`0 0 ${VIEWBOX} ${VIEWBOX}`}
						>
							<g class="tfig__context">
								{
									countries.map((country) => (
										<path
											d={pathFor(measure, series[country.iso3] ?? [])}
											data-iso={country.iso3}
										/>
									))
								}
							</g>
							<path class="tfig__median" d={pathFor(measure, median)} data-tfig-median></path>
							<g class="tfig__pinned" data-tfig-pinned>
								{
									pinned.map(({ iso3, slot }) => (
										<path
											d={pathFor(measure, series[iso3] ?? [])}
											data-iso={iso3}
											data-slot={slot}
										/>
									))
								}
							</g>
							<path class="tfig__hover" d="" data-tfig-hover></path>
						</svg>
					</div>
					<svg
						aria-hidden="true"
						class="tfig__density"
						preserveAspectRatio="none"
						viewBox={`0 0 ${VIEWBOX} ${VIEWBOX}`}
					>
						<path class="tfig__density-base" d="" data-tfig-density-base></path>
						<path class="tfig__density-now" d="" data-tfig-density-now></path>
					</svg>
					<div aria-hidden="true" class="tfig__dist-median" data-tfig-dist-median>
						<span data-tfig-dist-median-label></span>
					</div>
					<svg
						aria-hidden="true"
						class="tfig__fit"
						preserveAspectRatio="none"
						viewBox={`0 0 ${VIEWBOX} ${VIEWBOX}`}
					>
						<line data-tfig-fit x1="0" x2="0" y1="0" y2="0"></line>
					</svg>
					<div aria-hidden="true" class="tfig__swarm" data-tfig-swarm></div>
					<div
						aria-hidden="true"
						class="tfig__cursor"
						data-tfig-cursor
						style={`left: ${(xPosition(yearIndex) * 100).toFixed(2)}%`}
					>
					</div>
					<div aria-hidden="true" class="tfig__dots" data-tfig-dots>
						{
							pinned.map(({ iso3, slot }) => {
								const value = valueAt(measure.id, iso3, yearIndex);
								return value == null ? null : (
									<i
										data-slot={slot}
										style={`left: ${(xPosition(yearIndex) * 100).toFixed(2)}%; bottom: ${(position(measure, value) * 100).toFixed(2)}%`}
									/>
								);
							})
						}
					</div>
					<div aria-hidden="true" class="tfig__tooltip" data-tfig-tooltip hidden></div>
				</div>
				<div aria-hidden="true" class="tfig__labels" data-tfig-labels>
					{
						visibleLabels.map((label) => (
							<span
								data-key={label.key}
								data-slot={label.slot}
								style={`bottom: ${(label.pos * 100).toFixed(2)}%`}
							>
								{label.label}
							</span>
						))
					}
				</div>
				<div aria-hidden="true" class="tfig__xaxis" data-tfig-xaxis>
					{
						xTicks().map((tick) => (
							<span
								class:list={["num", !tick.major && "is-minor"]}
								style={`left: ${(tick.pos * 100).toFixed(2)}%`}
							>
								{tick.label}
							</span>
						))
					}
				</div>
			</div>
		</div>

		<div class="tfig__map">
			<p class="tfig__map-caption meta">
				<span data-tfig-map-what>Map shows {lastYear}.</span> Select up to three economies to compare.
			</p>
			<div
				aria-label="Economies"
				class="tfig__tiles"
				data-ramp={measure.ramp}
				data-tfig-tiles
				role="group"
				style={`--cols: ${TILE_COLUMNS}; --rows: ${TILE_ROWS}`}
			>
				{
					countries.map((country) => {
						const value = valueAt(measure.id, country.iso3, yearIndex);
						const pin = pinned.find((item) => item.iso3 === country.iso3);
						return (
							<button
								aria-label={`${country.name}: ${value == null ? "no data" : measure.format(value)} in ${lastYear}`}
								aria-pressed={pin ? "true" : "false"}
								class="tfig__tile"
								data-bin={binFor(measure, value)}
								data-iso={country.iso3}
								data-slot={pin?.slot}
								style={`grid-column: ${country.tile[0] + 1}; grid-row: ${country.tile[1] + 1}`}
								title={country.name}
								type="button"
							>
								{country.iso3}
							</button>
						);
					})
				}
			</div>
			<ol aria-label="Map legend" class="tfig__legend" data-ramp={measure.ramp} data-tfig-legend>
				{
					measure.binLabels.map((label, bin) => (
						<li data-bin={bin}>
							<i aria-hidden="true" />
							<span>{label}</span>
						</li>
					))
				}
				<li data-bin="na">
					<i aria-hidden="true"></i>
					<span>No data</span>
				</li>
			</ol>
		</div>
	</div>

	<div class="tfig__table-view" data-tfig-table-view hidden>
		<div class="tfig__table-scroll">
			<table class="tfig__table">
				<caption class="visually-hidden" data-tfig-table-caption>
					{measure.title} by economy in {lastYear}, sorted from highest to lowest
				</caption>
				<thead>
					<tr>
						<th scope="col">Economy</th>
						<th class="tfig__col-region" scope="col">Region</th>
						<th class="num" data-tfig-table-year scope="col">{lastYear}</th>
						<th class="tfig__col-trend" scope="col">{firstYear}–{lastYear}</th>
					</tr>
				</thead>
				<tbody data-tfig-table-body>
					{
						rows.map(({ country, value }) => (
							<tr>
								<th scope="row">{country.name}</th>
								<td class="tfig__col-region">{regionNames[country.region]}</td>
								<td class="num">{value == null ? "–" : measure.format(value)}</td>
								<td class="tfig__col-trend">
									<svg aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 100 24">
										<path d={sparkPath(measure, series[country.iso3] ?? [])} />
									</svg>
								</td>
							</tr>
						))
					}
				</tbody>
			</table>
		</div>
	</div>

	<figcaption class="tfig__foot">
		<p>
			Source: <span data-tfig-source>{sourceLine(measure)}</span>. <span data-tfig-note
				>{measure.note}</span
			>
		</p>
		<a class="tfig__download" download href="/data/transition.csv">Download CSV</a>
	</figcaption>
</figure>

<script is:inline>
	(() => {
		const figure = document.getElementById("figure-1");
		if (!figure || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
		if (new URLSearchParams(window.location.search).has("measure")) return;
		figure.classList.add("is-intro");
		const play = () => figure.classList.add("is-playing");
		figure.addEventListener("animationend", (event) => {
			if (event.animationName === "tfig-reveal") figure.classList.add("is-done");
		});
		if (!("IntersectionObserver" in window)) return play();
		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries.some((entry) => entry.isIntersecting)) return;
				play();
				observer.disconnect();
			},
			{ threshold: 0.4 },
		);
		observer.observe(figure);
	})();
</script>

<style is:global>
	.tfig {
		--plot-h: clamp(14rem, 26vw, 18rem);
		--pad: clamp(0.875rem, 2vw, 1.25rem);
		--tile-fill: var(--surface);

		/* Map ramps. Sequential: one hue, light to dark (anchor flips on the dark surface).
		   Diverging: red and blue arms around a grey midpoint. Heat: grey for deflation, then red. */
		--seq-0: light-dark(#cde2fb, #0d366b);
		--seq-1: light-dark(#9ec5f4, #184f95);
		--seq-2: light-dark(#6da7ec, #256abf);
		--seq-3: light-dark(#3987e5, #3987e5);
		--seq-4: light-dark(#256abf, #6da7ec);
		--seq-5: light-dark(#184f95, #9ec5f4);
		--seq-6: light-dark(#0d366b, #cde2fb);
		--div-0: light-dark(#970e1a, #fea79f);
		--div-1: light-dark(#e34948, #e34948);
		--div-2: light-dark(#fea79f, #970e1a);
		--div-3: light-dark(#e6eaef, #253244);
		--div-4: light-dark(#9ec5f4, #184f95);
		--div-5: light-dark(#3987e5, #3987e5);
		--div-6: light-dark(#184f95, #9ec5f4);
		/* Growth: red for shrinking, then one blue ramp for faster growth. */
		--grow-0: light-dark(#e34948, #e34948);
		--grow-1: light-dark(#cde2fb, #184f95);
		--grow-2: light-dark(#9ec5f4, #256abf);
		--grow-3: light-dark(#6da7ec, #3987e5);
		--grow-4: light-dark(#3987e5, #6da7ec);
		--grow-5: light-dark(#256abf, #9ec5f4);
		--grow-6: light-dark(#184f95, #cde2fb);
		/* Dots wear their tile's colour, with the lightest steps darkened so a
		   small dot still clears 2:1 against the plot (ordinal steps 250+ / 600-). */
		--dot-seq-0: light-dark(#86b6ef, #184f95);
		--dot-seq-1: light-dark(#5598e7, #256abf);
		--dot-seq-2: light-dark(#3987e5, #2a78d6);
		--dot-seq-3: light-dark(#2a78d6, #3987e5);
		--dot-seq-4: light-dark(#1c5cab, #6da7ec);
		--dot-seq-5: light-dark(#184f95, #9ec5f4);
		--dot-seq-6: light-dark(#0d366b, #cde2fb);
		--dot-grow-0: light-dark(#e34948, #e66767);
		--dot-grow-1: light-dark(#86b6ef, #184f95);
		--dot-grow-2: light-dark(#5598e7, #256abf);
		--dot-grow-3: light-dark(#3987e5, #3987e5);
		--dot-grow-4: light-dark(#2a78d6, #6da7ec);
		--dot-grow-5: light-dark(#1c5cab, #9ec5f4);
		--dot-grow-6: light-dark(#104281, #cde2fb);
		--on-dark: #ffffff;
		--on-light: #0b1b2e;

		scroll-margin-top: calc(var(--header-h) + 1.5rem);
	}

	/* ---------- head and controls ---------- */
	.tfig__head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		padding: 0.8rem var(--pad);
		border-bottom: 1px solid var(--rule);
	}

	.tfig__title {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.25rem 0.75rem;
		font-size: 0.9375rem;
		line-height: 1.4;
	}

	.tfig__view {
		display: inline-flex;
		padding: 2px;
		border: 1px solid var(--rule);
		border-radius: 3px;
		background: var(--paper);
	}

	.tfig__view-button {
		padding: 0.2rem 0.65rem;
		border: 0;
		border-radius: var(--radius);
		background: transparent;
		color: var(--ink-3);
		font-size: var(--step--1);
	}

	.tfig__view-button[aria-pressed="true"] {
		background: var(--surface);
		box-shadow: 0 0 0 1px var(--rule-strong);
		color: var(--ink);
	}

	.tfig__controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		padding: 0.65rem var(--pad);
		border-bottom: 1px solid var(--rule);
	}

	.tfig__tabs {
		display: flex;
		max-width: 100%;
		overflow-x: auto;
		gap: 0.25rem;
		scrollbar-width: none;
	}

	/* On narrow screens the strip scrolls sideways; fades mark the hidden tabs. */
	.tfig__tabs[data-overflow="end"] {
		mask-image: linear-gradient(to right, #000 calc(100% - 2.5rem), transparent);
	}

	.tfig__tabs[data-overflow="start"] {
		mask-image: linear-gradient(to left, #000 calc(100% - 2.5rem), transparent);
	}

	.tfig__tabs[data-overflow="both"] {
		mask-image: linear-gradient(
			to right,
			transparent,
			#000 2.5rem,
			#000 calc(100% - 2.5rem),
			transparent
		);
	}

	.tfig__tab {
		flex: none;
		padding: 0.35rem 0.75rem;
		border: 1px solid transparent;
		border-radius: var(--radius);
		background: transparent;
		color: var(--ink-2);
		font-size: 0.875rem;
		white-space: nowrap;
	}

	.tfig__tab:hover {
		color: var(--ink);
		background: var(--surface-2);
	}

	.tfig__tab[aria-selected="true"] {
		border-color: var(--signal);
		background: var(--signal-wash);
		color: var(--ink);
	}

	.tfig__time {
		display: flex;
		flex: 1 1 16rem;
		max-width: 26rem;
		align-items: center;
		gap: 0.75rem;
	}

	.tfig__play {
		display: grid;
		width: 2rem;
		height: 2rem;
		flex: none;
		place-items: center;
		border: 1px solid var(--rule-strong);
		border-radius: 50%;
		background: var(--surface);
		color: var(--ink);
	}

	.tfig__play:hover {
		border-color: var(--ink-3);
	}

	.tfig__play svg {
		width: 0.7rem;
		height: 0.7rem;
	}

	.tfig__pause-icon,
	.tfig.is-playing:not(.is-done):not(.is-paused) .tfig__play-icon {
		display: none;
	}

	.tfig.is-playing:not(.is-done):not(.is-paused) .tfig__pause-icon {
		display: block;
	}

	@media (prefers-reduced-motion: reduce) {
		.tfig__play {
			display: none;
		}
	}

	.tfig__range {
		min-width: 0;
		flex: 1;
		height: 1.5rem;
		margin: 0;
		background: transparent;
		accent-color: var(--signal);
		appearance: none;
		cursor: pointer;
	}

	.tfig__range::-webkit-slider-runnable-track {
		height: 2px;
		background: linear-gradient(var(--rule-strong), var(--rule-strong));
	}

	.tfig__range::-moz-range-track {
		height: 2px;
		background: var(--rule-strong);
	}

	.tfig__range::-webkit-slider-thumb {
		width: 0.875rem;
		height: 0.875rem;
		margin-top: calc(-0.4375rem + 1px);
		border: 2px solid var(--surface);
		border-radius: 50%;
		background: var(--signal);
		box-shadow: 0 0 0 1px var(--signal);
		appearance: none;
	}

	.tfig__range::-moz-range-thumb {
		width: 0.875rem;
		height: 0.875rem;
		border: 2px solid var(--surface);
		border-radius: 50%;
		background: var(--signal);
		box-shadow: 0 0 0 1px var(--signal);
	}

	.tfig__year {
		min-width: 2.75rem;
		font-size: 1.0625rem;
		font-weight: 500;
		text-align: right;
	}

	/* Convergence options: which form, measured against which benchmark. */
	.tfig__sub {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.6rem 1.75rem;
		padding: 0.55rem var(--pad);
		border-bottom: 1px solid var(--rule);
		background: color-mix(in srgb, var(--paper) 55%, var(--surface));
	}

	.tfig__sub[hidden] {
		display: none;
	}

	.tfig__seg {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem;
	}

	.tfig__seg-label {
		margin-right: 0.35rem;
		color: var(--ink-3);
		font-size: var(--step--1);
	}

	.tfig__seg button {
		padding: 0.2rem 0.65rem;
		border: 1px solid var(--rule-strong);
		border-radius: 999px;
		background: var(--surface);
		color: var(--ink-2);
		font-size: var(--step--1);
	}

	.tfig__seg button:hover {
		border-color: var(--ink-3);
		color: var(--ink);
	}

	.tfig__seg button[aria-pressed="true"] {
		border-color: var(--signal);
		background: var(--signal-wash);
		color: var(--ink);
	}

	.tfig__frontier-key {
		width: 1rem;
		height: 1.5px;
		background: var(--axis-line);
		box-shadow: 0 0 0 0.5px var(--axis-line);
	}

	/* ---------- chart ---------- */
	.tfig__body {
		display: grid;
	}

	.tfig__body[hidden] {
		display: none;
	}

	.tfig__chart {
		min-width: 0;
		padding: var(--pad);
	}

	.tfig__keys {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 1.25rem;
		min-height: 1.75rem;
		margin-bottom: 1rem;
		font-size: 0.875rem;
	}

	.tfig__key {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	.tfig__line-key {
		width: 1rem;
		height: 2px;
		border-radius: 1px;
		background: var(--key, var(--median-line));
	}

	.tfig__key[data-slot="1"] {
		--key: var(--series-1);
	}

	.tfig__key[data-slot="2"] {
		--key: var(--series-2);
	}

	.tfig__key[data-slot="3"] {
		--key: var(--series-3);
	}

	.tfig__key--median .tfig__line-key {
		height: 1.5px;
	}

	.tfig__key-name {
		color: var(--ink-2);
	}

	.tfig__key-value {
		font-weight: 600;
	}

	.tfig__key-remove {
		display: grid;
		width: 1.25rem;
		height: 1.25rem;
		place-items: center;
		margin-left: -0.15rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--ink-3);
	}

	.tfig__key-remove:hover {
		background: var(--surface-2);
		color: var(--ink);
	}

	.tfig__key-remove svg {
		width: 0.55rem;
		height: 0.55rem;
	}

	.tfig__plot {
		display: grid;
		grid-template-columns: calc(var(--ychars, 4) * 0.42rem + 0.9rem) minmax(0, 1fr) 7rem;
		grid-template-rows: var(--plot-h) 1.75rem;
	}

	.tfig__yaxis,
	.tfig__labels {
		position: relative;
		grid-row: 1;
		color: var(--ink-3);
		font-size: var(--step--2);
	}

	.tfig__yaxis span {
		position: absolute;
		right: 0.6rem;
		transform: translateY(50%);
		line-height: 1;
	}

	.tfig__canvas {
		position: relative;
		grid-row: 1;
		grid-column: 2;
		touch-action: pan-y;
		cursor: crosshair;
	}

	.tfig__canvas svg,
	.tfig__ink {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.tfig__grid line {
		stroke: var(--grid-line);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
		shape-rendering: crispEdges;
	}

	.tfig__grid line.is-baseline {
		stroke: var(--axis-line);
	}

	.tfig__ink path {
		fill: none;
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}

	.tfig__context path {
		stroke: var(--context-line);
		stroke-width: 1.15;
		transition: stroke 160ms var(--ease);
	}

	.tfig__median {
		stroke: var(--median-line);
		stroke-width: 1.5;
	}

	.tfig__pinned path {
		stroke-width: 2.25;
	}

	.tfig__pinned path[data-slot="1"],
	.tfig__dots i[data-slot="1"] {
		stroke: var(--series-1);
		--dot: var(--series-1);
	}

	.tfig__pinned path[data-slot="2"],
	.tfig__dots i[data-slot="2"] {
		stroke: var(--series-2);
		--dot: var(--series-2);
	}

	.tfig__pinned path[data-slot="3"],
	.tfig__dots i[data-slot="3"] {
		stroke: var(--series-3);
		--dot: var(--series-3);
	}

	.tfig__hover {
		stroke: var(--ink);
		stroke-width: 2;
	}

	.tfig__cursor {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--ink-3);
		opacity: 0.6;
		pointer-events: none;
	}

	.tfig__dots i {
		position: absolute;
		width: 0.625rem;
		height: 0.625rem;
		border: 2px solid var(--surface);
		border-radius: 50%;
		background: var(--dot, var(--ink));
		transform: translate(-50%, 50%);
		pointer-events: none;
	}

	/* ---------- distribution view: one dot per economy, density curves, median ---------- */
	.tfig__density,
	.tfig__dist-median,
	.tfig__swarm,
	.tfig__fit {
		display: none;
	}

	.tfig[data-kind="distribution"] :is(.tfig__density, .tfig__dist-median, .tfig__swarm),
	.tfig[data-kind="convergence"] :is(.tfig__swarm, .tfig__fit) {
		display: block;
	}

	.tfig:is([data-kind="distribution"], [data-kind="convergence"])
		:is(.tfig__ink, .tfig__cursor, .tfig__dots, .tfig__labels) {
		display: none;
	}

	.tfig[data-kind="distribution"] .tfig__yaxis {
		display: none;
	}

	.tfig[data-kind="distribution"] .tfig__plot {
		grid-template-columns: 1rem minmax(0, 1fr) 1rem;
	}

	.tfig[data-kind="convergence"] .tfig__plot {
		grid-template-columns: calc(var(--ychars, 4) * 0.42rem + 0.9rem) minmax(0, 1fr) 1.25rem;
	}

	.tfig:is([data-kind="distribution"], [data-kind="convergence"]) .tfig__canvas {
		cursor: default;
	}

	/* Convergence: least-squares line through the dots. */
	.tfig__fit {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.tfig__fit line {
		stroke: var(--median-line);
		stroke-width: 1.5;
		stroke-linecap: round;
		vector-effect: non-scaling-stroke;
		transition: all 350ms var(--ease);
	}

	/* A small bracket: the spread across economies. */
	.tfig__spread-key {
		width: 1rem;
		height: 0.45rem;
		border: 1.5px solid var(--ink-3);
		border-top: 0;
	}

	.tfig__fit-key {
		width: 1rem;
		height: 1.5px;
		background: var(--median-line);
		transform: rotate(-18deg);
	}

	.tfig__density {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.tfig__density path {
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}

	.tfig__density-now {
		fill: color-mix(in srgb, var(--signal) 11%, transparent);
		stroke: var(--signal);
		stroke-width: 1.5;
	}

	.tfig__density-base {
		fill: none;
		stroke: var(--ink-3);
		stroke-width: 1.25;
	}

	.tfig__dist-median {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--median-line);
		pointer-events: none;
		transition: left 350ms var(--ease);
	}

	.tfig__dist-median[hidden] {
		display: none !important;
	}

	.tfig__dist-median span {
		position: absolute;
		top: 0;
		left: 0.35rem;
		padding: 0 0.3rem;
		background: var(--surface);
		color: var(--ink-2);
		font-size: var(--step--2);
		line-height: 1.5;
		white-space: nowrap;
	}

	.tfig__dist-median.is-flipped span {
		right: 0.35rem;
		left: auto;
	}

	.tfig__swarm {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.tfig__swarm i {
		position: absolute;
		width: calc(var(--r, 6px) * 2);
		height: calc(var(--r, 6px) * 2);
		border: 1.5px solid var(--surface);
		border-radius: 50%;
		background: var(--dot-fill, var(--ink-3));
		transform: translate(-50%, 50%);
		transition:
			left 350ms var(--ease),
			bottom 350ms var(--ease),
			opacity 200ms var(--ease);
	}

	/* Compared economies keep their fill and get their series ring, as on the map. */
	.tfig__swarm i[data-slot] {
		z-index: 2;
		box-shadow: 0 0 0 2px var(--ring);
	}

	.tfig__swarm i[data-slot="1"] {
		--ring: var(--series-1);
	}

	.tfig__swarm i[data-slot="2"] {
		--ring: var(--series-2);
	}

	.tfig__swarm i[data-slot="3"] {
		--ring: var(--series-3);
	}

	.tfig__swarm i.is-hovered {
		z-index: 3;
		box-shadow: 0 0 0 2px var(--ink);
	}

	.tfig__swarm i.is-missing {
		opacity: 0;
	}

	.tfig__swarm span {
		position: absolute;
		z-index: 4;
		padding: 0 0.25rem;
		border-radius: var(--radius);
		background: color-mix(in srgb, var(--surface) 88%, transparent);
		color: var(--ink);
		font-size: var(--step--2);
		line-height: 1.4;
		white-space: nowrap;
		transform: translateX(-50%);
		transition:
			left 350ms var(--ease),
			bottom 350ms var(--ease);
	}

	.tfig.is-sweeping :is(.tfig__swarm i, .tfig__swarm span, .tfig__dist-median) {
		transition-duration: 150ms;
		transition-timing-function: linear;
	}

	.tfig.is-sweeping .tfig__play-icon {
		display: none;
	}

	.tfig.is-sweeping .tfig__pause-icon {
		display: block;
	}

	.tfig__area-key {
		width: 1rem;
		height: 0.6rem;
		border-top: 1.5px solid var(--signal);
		background: color-mix(in srgb, var(--signal) 14%, transparent);
	}

	.tfig__outline-key {
		width: 1rem;
		height: 0.6rem;
		border-top: 1.25px solid var(--ink-3);
	}

	.tfig__labels span {
		position: absolute;
		left: 0.6rem;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		max-width: 6.4rem;
		overflow: hidden;
		color: var(--ink-2);
		font-size: var(--step--1);
		line-height: 1;
		text-overflow: ellipsis;
		white-space: nowrap;
		transform: translateY(50%);
	}

	.tfig__labels span::before {
		width: 0.4rem;
		height: 2px;
		flex: none;
		background: var(--median-line);
		content: "";
	}

	.tfig__labels span[data-slot="1"]::before {
		background: var(--series-1);
	}

	.tfig__labels span[data-slot="2"]::before {
		background: var(--series-2);
	}

	.tfig__labels span[data-slot="3"]::before {
		background: var(--series-3);
	}

	.tfig__labels span[hidden] {
		display: none;
	}

	.tfig__xaxis {
		position: relative;
		grid-row: 2;
		grid-column: 2;
		color: var(--ink-3);
		font-size: var(--step--2);
	}

	.tfig__xaxis span {
		position: absolute;
		top: 0.55rem;
		transform: translateX(-50%);
		line-height: 1;
	}

	.tfig__tooltip {
		position: absolute;
		z-index: 2;
		min-width: 8rem;
		padding: 0.45rem 0.6rem;
		border: 1px solid var(--rule-strong);
		border-radius: var(--radius);
		background: var(--surface);
		box-shadow: 0 6px 20px -8px rgb(7 17 31 / 0.35);
		font-size: var(--step--1);
		line-height: 1.35;
		pointer-events: none;
		white-space: nowrap;
	}

	.tfig__tooltip[hidden] {
		display: none;
	}

	.tfig__tooltip strong {
		display: block;
		font-size: 0.9375rem;
		font-variant-numeric: tabular-nums;
		font-weight: 600;
	}

	.tfig__tooltip span {
		color: var(--ink-3);
	}

	/* Intro: the lines draw from 1990 to the latest year once, as the figure scrolls into view. */
	.tfig.is-intro .tfig__ink {
		clip-path: inset(0 100% 0 0);
	}

	.tfig.is-intro.is-playing .tfig__ink {
		animation: tfig-reveal 3600ms linear forwards;
	}

	.tfig.is-intro.is-paused .tfig__ink {
		animation-play-state: paused;
	}

	.tfig.is-intro:not(.is-done) .tfig__labels {
		opacity: 0;
	}

	.tfig.is-done .tfig__labels {
		transition: opacity 400ms var(--ease);
	}

	@keyframes tfig-reveal {
		from {
			clip-path: inset(0 100% 0 0);
		}

		to {
			clip-path: inset(0 0 0 0);
		}
	}

	/* ---------- map ---------- */
	.tfig__map {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 0.9rem;
		padding: var(--pad);
		border-top: 1px solid var(--rule);
	}

	.tfig__tiles {
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		grid-template-rows: repeat(var(--rows), auto);
		gap: 3px;
		max-width: 24rem;
	}

	.tfig__tile {
		display: grid;
		aspect-ratio: 1;
		place-items: center;
		padding: 0;
		border: 0;
		border-radius: 2px;
		background: var(--tile-fill);
		color: var(--tile-ink, var(--on-light));
		font-size: clamp(0.5625rem, 1.6vw, 0.6875rem);
		font-stretch: 80%;
		font-weight: 600;
		letter-spacing: 0.01em;
		line-height: 1;
		transition:
			background-color 220ms var(--ease),
			color 220ms var(--ease),
			box-shadow 120ms var(--ease);
	}

	.tfig__tile:hover,
	.tfig__tile.is-hovered {
		box-shadow:
			0 0 0 1px var(--surface),
			0 0 0 2.5px var(--ink);
	}

	.tfig__tile[data-slot="1"] {
		box-shadow:
			0 0 0 1.5px var(--surface),
			0 0 0 3.5px var(--series-1);
	}

	.tfig__tile[data-slot="2"] {
		box-shadow:
			0 0 0 1.5px var(--surface),
			0 0 0 3.5px var(--series-2);
	}

	.tfig__tile[data-slot="3"] {
		box-shadow:
			0 0 0 1.5px var(--surface),
			0 0 0 3.5px var(--series-3);
	}

	.tfig__tile[data-bin="na"],
	.tfig__legend [data-bin="na"] i {
		--tile-fill: var(--surface);
		--tile-ink: var(--ink-3);
		box-shadow: inset 0 0 0 1px var(--rule-strong);
	}

	/* Bin colours per ramp; label ink chosen per fill for contrast. */
	.tfig [data-ramp="seq"] > [data-bin="0"] {
		--tile-fill: var(--seq-0);
		--tile-ink: light-dark(var(--on-light), var(--on-dark));
	}
	.tfig [data-ramp="seq"] > [data-bin="1"] {
		--tile-fill: var(--seq-1);
		--tile-ink: light-dark(var(--on-light), var(--on-dark));
	}
	.tfig [data-ramp="seq"] > [data-bin="2"] {
		--tile-fill: var(--seq-2);
		--tile-ink: light-dark(var(--on-light), var(--on-dark));
	}
	.tfig [data-ramp="seq"] > [data-bin="3"] {
		--tile-fill: var(--seq-3);
		--tile-ink: var(--on-light);
	}
	.tfig [data-ramp="seq"] > [data-bin="4"] {
		--tile-fill: var(--seq-4);
		--tile-ink: light-dark(var(--on-dark), var(--on-light));
	}
	.tfig [data-ramp="seq"] > [data-bin="5"] {
		--tile-fill: var(--seq-5);
		--tile-ink: light-dark(var(--on-dark), var(--on-light));
	}
	.tfig [data-ramp="seq"] > [data-bin="6"] {
		--tile-fill: var(--seq-6);
		--tile-ink: light-dark(var(--on-dark), var(--on-light));
	}
	.tfig [data-ramp="div"] > [data-bin="0"] {
		--tile-fill: var(--div-0);
		--tile-ink: light-dark(var(--on-dark), var(--on-light));
	}
	.tfig [data-ramp="div"] > [data-bin="1"] {
		--tile-fill: var(--div-1);
		--tile-ink: var(--on-light);
	}
	.tfig [data-ramp="div"] > [data-bin="2"] {
		--tile-fill: var(--div-2);
		--tile-ink: light-dark(var(--on-light), var(--on-dark));
	}
	.tfig [data-ramp="div"] > [data-bin="3"] {
		--tile-fill: var(--div-3);
		--tile-ink: light-dark(var(--on-light), #e8eef6);
	}
	.tfig [data-ramp="div"] > [data-bin="4"] {
		--tile-fill: var(--div-4);
		--tile-ink: light-dark(var(--on-light), var(--on-dark));
	}
	.tfig [data-ramp="div"] > [data-bin="5"] {
		--tile-fill: var(--div-5);
		--tile-ink: var(--on-light);
	}
	.tfig [data-ramp="div"] > [data-bin="6"] {
		--tile-fill: var(--div-6);
		--tile-ink: light-dark(var(--on-dark), var(--on-light));
	}
	.tfig [data-ramp="grow"] > [data-bin="0"] {
		--tile-fill: var(--grow-0);
		--tile-ink: var(--on-light);
	}
	.tfig [data-ramp="grow"] > [data-bin="1"] {
		--tile-fill: var(--grow-1);
		--tile-ink: light-dark(var(--on-light), var(--on-dark));
	}
	.tfig [data-ramp="grow"] > [data-bin="2"] {
		--tile-fill: var(--grow-2);
		--tile-ink: light-dark(var(--on-light), var(--on-dark));
	}
	.tfig [data-ramp="grow"] > [data-bin="3"] {
		--tile-fill: var(--grow-3);
		--tile-ink: var(--on-light);
	}
	.tfig [data-ramp="grow"] > [data-bin="4"] {
		--tile-fill: var(--grow-4);
		--tile-ink: var(--on-light);
	}
	.tfig [data-ramp="grow"] > [data-bin="5"] {
		--tile-fill: var(--grow-5);
		--tile-ink: light-dark(var(--on-dark), var(--on-light));
	}
	.tfig [data-ramp="grow"] > [data-bin="6"] {
		--tile-fill: var(--grow-6);
		--tile-ink: light-dark(var(--on-dark), var(--on-light));
	}

	.tfig__swarm[data-ramp="seq"] i[data-bin="0"] {
		--dot-fill: var(--dot-seq-0);
	}
	.tfig__swarm[data-ramp="seq"] i[data-bin="1"] {
		--dot-fill: var(--dot-seq-1);
	}
	.tfig__swarm[data-ramp="seq"] i[data-bin="2"] {
		--dot-fill: var(--dot-seq-2);
	}
	.tfig__swarm[data-ramp="seq"] i[data-bin="3"] {
		--dot-fill: var(--dot-seq-3);
	}
	.tfig__swarm[data-ramp="seq"] i[data-bin="4"] {
		--dot-fill: var(--dot-seq-4);
	}
	.tfig__swarm[data-ramp="seq"] i[data-bin="5"] {
		--dot-fill: var(--dot-seq-5);
	}
	.tfig__swarm[data-ramp="seq"] i[data-bin="6"] {
		--dot-fill: var(--dot-seq-6);
	}
	.tfig__swarm[data-ramp="grow"] i[data-bin="0"] {
		--dot-fill: var(--dot-grow-0);
	}
	.tfig__swarm[data-ramp="grow"] i[data-bin="1"] {
		--dot-fill: var(--dot-grow-1);
	}
	.tfig__swarm[data-ramp="grow"] i[data-bin="2"] {
		--dot-fill: var(--dot-grow-2);
	}
	.tfig__swarm[data-ramp="grow"] i[data-bin="3"] {
		--dot-fill: var(--dot-grow-3);
	}
	.tfig__swarm[data-ramp="grow"] i[data-bin="4"] {
		--dot-fill: var(--dot-grow-4);
	}
	.tfig__swarm[data-ramp="grow"] i[data-bin="5"] {
		--dot-fill: var(--dot-grow-5);
	}
	.tfig__swarm[data-ramp="grow"] i[data-bin="6"] {
		--dot-fill: var(--dot-grow-6);
	}

	.tfig__legend {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
		gap: 0.3rem 0.75rem;
		max-width: 24rem;
		padding: 0;
		list-style: none;
		color: var(--ink-2);
		font-size: var(--step--2);
	}

	.tfig__legend li {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.tfig__legend i {
		width: 0.75rem;
		height: 0.75rem;
		flex: none;
		border-radius: 2px;
		background: var(--tile-fill);
	}

	.tfig__legend[data-ramp] > li > i {
		background: var(--tile-fill);
	}

	/* ---------- table ---------- */
	.tfig__table-view[hidden] {
		display: none;
	}

	.tfig__table-scroll {
		max-height: 30rem;
		overflow: auto;
		overscroll-behavior: contain;
	}

	.tfig__table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.875rem;
	}

	.tfig__table thead th {
		position: sticky;
		top: 0;
		z-index: 1;
		background: var(--surface);
		color: var(--ink-3);
		font-size: var(--step--1);
		font-weight: 500;
		box-shadow: inset 0 -1px 0 var(--rule);
	}

	.tfig__table :where(th, td) {
		padding: 0.5rem var(--pad);
		text-align: left;
	}

	.tfig__table tbody tr + tr :where(th, td) {
		border-top: 1px solid var(--rule);
	}

	.tfig__table tbody th {
		font-weight: 500;
	}

	.tfig__table .num {
		text-align: right;
		font-variant-numeric: tabular-nums;
	}

	.tfig__col-region {
		color: var(--ink-2);
	}

	.tfig__col-trend {
		width: 9rem;
	}

	.tfig__col-trend svg {
		width: 100%;
		height: 1.25rem;
	}

	.tfig__col-trend path {
		fill: none;
		stroke: var(--signal);
		stroke-width: 1.25;
		vector-effect: non-scaling-stroke;
	}

	/* ---------- foot ---------- */
	.tfig__foot {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem 2rem;
		padding: 0.75rem var(--pad);
		border-top: 1px solid var(--rule);
		color: var(--ink-3);
		font-size: var(--step--1);
		line-height: 1.5;
	}

	.tfig__foot p {
		max-width: 60rem;
	}

	.tfig__download {
		color: var(--signal-ink);
		white-space: nowrap;
	}

	@media (min-width: 64rem) {
		.tfig__body {
			grid-template-columns: minmax(0, 1fr) clamp(19rem, 26vw, 24rem);
		}

		.tfig__map {
			border-top: 0;
			border-left: 1px solid var(--rule);
		}

		.tfig__legend {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 40rem) {
		.tfig__plot {
			grid-template-columns: calc(var(--ychars, 4) * 0.42rem + 0.75rem) minmax(0, 1fr) 0.75rem;
		}

		.tfig__labels {
			display: none;
		}

		/* Two legend entries per row on common phone widths: units stay for screen readers only. */
		.tfig__keys {
			column-gap: 0.85rem;
			font-size: 0.8125rem;
		}

		.tfig__unit {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}

		.tfig__xaxis .is-minor {
			display: none;
		}

		.tfig__col-region {
			display: none;
		}

		.tfig__col-trend {
			width: 5.5rem;
		}

		.tfig__time {
			max-width: none;
		}
	}
</style>

<script>
	import {
		binFor,
		countries,
		convergenceFit,
		convergencePoints,
		countryByIso,
		DEFAULT_CONVERGENCE_START,
		DEFAULT_MEASURE,
		DEFAULT_PINNED,
		densityPath,
		distributionValues,
		figureTitle,
		firstYear,
		lastIndexWithValue,
		lastYear,
		MAX_PINNED,
		maxStartIndex,
		maxYearIndex,
		type MeasureId,
		benchmarkLabel,
		benchmarkPhrase,
		type BenchmarkId,
		type ConvergenceForm,
		convergenceMeasureId,
		DEFAULT_BENCHMARK,
		DEFAULT_FORM,
		formatParts,
		isMeasureId,
		measureForTab,
		measures,
		medianRelativeIncome,
		relativeIncomeAxis,
		type TabId,
		tabOrder,
		medianSeries,
		pathFor,
		position,
		regionNames,
		seriesFor,
		sourceLine,
		sparkPath,
		spreadLabels,
		tableRows,
		tickLabelChars,
		tickPositions,
		valueAt,
		VIEWBOX,
		xPosition,
		xTicks,
		years,
	} from "@/lib/transition";

	const root = document.querySelector<HTMLElement>("[data-tfig]");

	const q = <T extends Element>(selector: string) => root?.querySelector<T>(selector) ?? null;
	const svgNS = "http://www.w3.org/2000/svg";

	if (root) {
		const els = {
			canvas: q<HTMLElement>("[data-tfig-canvas]"),
			chartView: q<HTMLElement>("[data-tfig-chart-view]"),
			cursor: q<HTMLElement>("[data-tfig-cursor]"),
			densityBase: q<SVGPathElement>("[data-tfig-density-base]"),
			densityNow: q<SVGPathElement>("[data-tfig-density-now]"),
			distMedian: q<HTMLElement>("[data-tfig-dist-median]"),
			distMedianLabel: q<HTMLElement>("[data-tfig-dist-median-label]"),
			fit: q<SVGLineElement>("[data-tfig-fit]"),
			dots: q<HTMLElement>("[data-tfig-dots]"),
			grid: q<SVGSVGElement>("[data-tfig-grid]"),
			hover: q<SVGPathElement>("[data-tfig-hover]"),
			ink: q<HTMLElement>("[data-tfig-ink]"),
			keys: q<HTMLUListElement>("[data-tfig-keys]"),
			labels: q<HTMLElement>("[data-tfig-labels]"),
			legend: q<HTMLOListElement>("[data-tfig-legend]"),
			mapWhat: q<HTMLElement>("[data-tfig-map-what]"),
			median: q<SVGPathElement>("[data-tfig-median]"),
			note: q<HTMLElement>("[data-tfig-note]"),
			source: q<HTMLElement>("[data-tfig-source]"),
			pinned: q<SVGGElement>("[data-tfig-pinned]"),
			plot: q<HTMLElement>("[data-tfig-plot]"),
			play: q<HTMLButtonElement>("[data-tfig-play]"),
			range: q<HTMLInputElement>("[data-tfig-year]"),
			swarm: q<HTMLElement>("[data-tfig-swarm]"),
			tableBody: q<HTMLTableSectionElement>("[data-tfig-table-body]"),
			tableCaption: q<HTMLElement>("[data-tfig-table-caption]"),
			tableView: q<HTMLElement>("[data-tfig-table-view]"),
			tableYear: q<HTMLElement>("[data-tfig-table-year]"),
			tiles: q<HTMLElement>("[data-tfig-tiles]"),
			title: q<HTMLElement>("[data-tfig-title]"),
			tooltip: q<HTMLElement>("[data-tfig-tooltip]"),
			xaxis: q<HTMLElement>("[data-tfig-xaxis]"),
			yaxis: q<HTMLElement>("[data-tfig-yaxis]"),
			yearLabel: q<HTMLOutputElement>("[data-tfig-year-label]"),
		};

		const contextPaths = new Map(
			Array.from(root.querySelectorAll<SVGPathElement>(".tfig__context path")).map((path) => [
				path.dataset.iso ?? "",
				path,
			]),
		);
		const tiles = new Map(
			Array.from(root.querySelectorAll<HTMLButtonElement>(".tfig__tile")).map((tile) => [
				tile.dataset.iso ?? "",
				tile,
			]),
		);
		const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tfig-tab]"));
		const tabStrip = q<HTMLElement>("[data-tfig-tabs]");
		const sub = q<HTMLElement>("[data-tfig-sub]");
		const formButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tfig-form]"));
		const benchmarkButtons = Array.from(
			root.querySelectorAll<HTMLButtonElement>("[data-tfig-benchmark]"),
		);
		const viewButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tfig-view]"));

		const state = {
			hover: null as { iso: string | null; yearIndex: number } | null,
			measure: DEFAULT_MEASURE as MeasureId,
			benchmark: DEFAULT_BENCHMARK as BenchmarkId,
			form: DEFAULT_FORM as ConvergenceForm,
			pinned: [...DEFAULT_PINNED] as string[],
			slots: new Map<string, number>(DEFAULT_PINNED.map((iso, index) => [iso, index + 1])),
			view: "chart" as "chart" | "table",
			yearIndex: years.length - 1,
		};

		const m = () => measures[state.measure];
		const shownYear = () => state.hover?.yearIndex ?? state.yearIndex;
		const pct = (value: number) => `${(value * 100).toFixed(2)}%`;
		const isDist = () => m().kind === "distribution";
		const isConv = () => m().kind === "convergence";
		const reduceMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		/** Views drawn with one dot per economy rather than lines over time. */
		const usesDots = () => m().kind !== "series";
		/** Last selectable year: the latest data, or for convergence ten years before it. */
		const maxIndex = () => maxYearIndex(m());
		const yearSpan = (yearIndex: number) =>
			isConv() ? `${years[yearIndex]}–${lastYear}` : String(years[yearIndex]);
		const countWithData = (yearIndex: number) =>
			countries.filter((country) => valueAt(m().id, country.iso3, yearIndex) != null).length;

		/* ---------- intro sync ---------- */
		let introFrame = 0;
		let sweepTimer = 0;
		const introAnimation = () =>
			els.ink
				?.getAnimations()
				.find((animation) => (animation as CSSAnimation).animationName === "tfig-reveal");

		const finishIntro = () => {
			const cutShort = introRunning();
			window.cancelAnimationFrame(introFrame);
			introFrame = 0;
			introAnimation()?.finish();
			if (root.classList.contains("is-intro")) root.classList.add("is-done");
			root.classList.remove("is-paused");
			// An interrupted intro lands where it would have ended: the latest year.
			if (cutShort) {
				state.yearIndex = maxIndex();
				renderYear();
			}
			updatePlayLabel();
		};

		const syncIntro = () => {
			const animation = introAnimation();
			if (!animation) {
				if (root.classList.contains("is-playing")) finishIntro();
				else introFrame = window.requestAnimationFrame(syncIntro);
				return;
			}
			const progress = Math.min(
				1,
				Math.max(0, animation.effect?.getComputedTiming().progress ?? 1),
			);
			const index = Math.min(years.length - 1, Math.floor(progress * (years.length - 1) + 0.0001));
			if (els.cursor) els.cursor.style.left = pct(progress);
			if (index !== state.yearIndex) {
				state.yearIndex = index;
				renderYear({ cursor: false });
			}
			if (animation.playState === "finished" || progress >= 1) {
				state.yearIndex = years.length - 1;
				renderYear();
				root.classList.add("is-done");
				introFrame = 0;
				updatePlayLabel();
				return;
			}
			introFrame = window.requestAnimationFrame(syncIntro);
		};

		const introRunning = () =>
			root.classList.contains("is-intro") && !root.classList.contains("is-done");

		const updatePlayLabel = () => {
			if (!els.play) return;
			if (usesDots()) {
				els.play.setAttribute(
					"aria-label",
					sweepTimer
						? "Pause"
						: isConv()
							? `Play start years ${firstYear} to ${years[maxStartIndex]}`
							: `Play ${firstYear} to ${lastYear}`,
				);
				return;
			}
			const playing =
				introRunning() &&
				root.classList.contains("is-playing") &&
				!root.classList.contains("is-paused");
			els.play.setAttribute(
				"aria-label",
				playing ? "Pause" : introRunning() ? "Resume" : `Replay from ${firstYear}`,
			);
		};

		const replay = () => {
			window.cancelAnimationFrame(introFrame);
			root.classList.remove("is-done", "is-playing", "is-paused");
			root.classList.add("is-intro");
			void root.offsetWidth;
			root.classList.add("is-playing");
			state.hover = null;
			introFrame = window.requestAnimationFrame(syncIntro);
			updatePlayLabel();
		};

		/* Dot views: step through the years (or start years) so the dots travel. */
		const stopSweep = () => {
			if (!sweepTimer) return;
			window.clearInterval(sweepTimer);
			sweepTimer = 0;
			root.classList.remove("is-sweeping");
			updatePlayLabel();
			writeUrl();
		};

		const startSweep = () => {
			if (state.yearIndex >= maxIndex()) state.yearIndex = 0;
			state.hover = null;
			root.classList.add("is-sweeping");
			renderHover();
			renderTooltip();
			renderYear();
			sweepTimer = window.setInterval(
				() => {
					if (state.yearIndex >= maxIndex()) {
						stopSweep();
						return;
					}
					state.yearIndex += 1;
					renderYear();
				},
				isConv() ? 260 : 170,
			);
			updatePlayLabel();
		};

		els.play?.addEventListener("click", () => {
			if (usesDots()) {
				if (sweepTimer) stopSweep();
				else startSweep();
				return;
			}
			if (!introRunning()) return replay();
			if (!root.classList.contains("is-playing")) {
				root.classList.add("is-playing");
				introFrame = window.requestAnimationFrame(syncIntro);
			} else {
				root.classList.toggle("is-paused");
				if (!root.classList.contains("is-paused"))
					introFrame = window.requestAnimationFrame(syncIntro);
			}
			updatePlayLabel();
		});

		/* ---------- rendering ---------- */
		const renderAxes = () => {
			const measure = m();
			const ticks = tickPositions(measure);
			els.plot?.style.setProperty("--ychars", String(tickLabelChars(measure)));
			if (els.yaxis) {
				els.yaxis.replaceChildren(
					...ticks.map((tick) => {
						const span = document.createElement("span");
						span.className = "num";
						span.style.bottom = pct(tick.pos);
						span.textContent = tick.label;
						return span;
					}),
				);
			}
			const dist = measure.kind === "distribution";
			const conv = measure.kind === "convergence";
			// Income runs along x in the dot views: the distribution's own axis, or starting income.
			const incomeTicks = dist
				? ticks
				: conv
					? tickPositions(relativeIncomeAxis(measure.benchmark ?? DEFAULT_BENCHMARK))
					: [];
			const gridLine = (x1: number, x2: number, y1: number, y2: number, strong = false) => {
				const line = document.createElementNS(svgNS, "line");
				line.setAttribute("x1", x1.toFixed(1));
				line.setAttribute("x2", x2.toFixed(1));
				line.setAttribute("y1", y1.toFixed(1));
				line.setAttribute("y2", y2.toFixed(1));
				if (strong) line.classList.add("is-baseline");
				return line;
			};
			if (els.grid) {
				const valueLines = dist
					? []
					: ticks.map((tick) => {
							const y = (1 - tick.pos) * VIEWBOX;
							return gridLine(0, VIEWBOX, y, y, tick.strong);
						});
				const incomeLines = incomeTicks.map((tick) => {
					const x = tick.pos * VIEWBOX;
					// In catch-up, the strong vertical line is the benchmark's own income (100%).
					return gridLine(x, x, 0, VIEWBOX, conv && tick.strong);
				});
				els.grid.replaceChildren(...incomeLines, ...valueLines);
			}
			if (els.xaxis) {
				const labels =
					dist || conv
						? incomeTicks.map((tick) => ({ label: tick.label, major: true, pos: tick.pos }))
						: xTicks();
				els.xaxis.replaceChildren(
					...labels.map((tick) => {
						const span = document.createElement("span");
						span.className = tick.major ? "num" : "num is-minor";
						span.style.left = pct(tick.pos);
						span.textContent = tick.label;
						return span;
					}),
				);
			}
		};

		const renderLines = () => {
			const measure = m();
			const series = seriesFor(measure.id);
			for (const [iso, path] of contextPaths)
				path.setAttribute("d", pathFor(measure, series[iso] ?? []));
			els.median?.setAttribute("d", pathFor(measure, medianSeries(measure.id)));
		};

		const renderPinned = () => {
			const measure = m();
			const series = seriesFor(measure.id);
			if (els.pinned) {
				els.pinned.replaceChildren(
					...state.pinned.map((iso) => {
						const path = document.createElementNS(svgNS, "path");
						path.setAttribute("d", pathFor(measure, series[iso] ?? []));
						path.dataset.iso = iso;
						path.dataset.slot = String(state.slots.get(iso) ?? 1);
						return path;
					}),
				);
			}
			for (const [iso, tile] of tiles) {
				const slot = state.slots.get(iso);
				tile.setAttribute("aria-pressed", String(Boolean(slot)));
				if (slot) tile.dataset.slot = String(slot);
				else delete tile.dataset.slot;
			}
			renderKeys();
			renderEndLabels();
		};

		/** Legend value; its unit is in a span that phones hide (the axis already gives it). */
		const fillValue = (el: HTMLElement, value: number | null) => {
			if (value == null) {
				el.textContent = "No data";
				return;
			}
			const { number, unit } = formatParts(m(), value);
			el.textContent = number;
			if (!unit) return;
			const suffix = document.createElement("span");
			suffix.className = "tfig__unit";
			suffix.textContent = unit;
			el.append(suffix);
		};

		const renderKeys = () => {
			if (!els.keys) return;
			const measure = m();
			const yearIndex = shownYear();
			const items = state.pinned.map((iso) => {
				const country = countryByIso.get(iso);
				const value = valueAt(measure.id, iso, yearIndex);
				const li = document.createElement("li");
				li.className = "tfig__key";
				li.dataset.iso = iso;
				li.dataset.slot = String(state.slots.get(iso) ?? 1);
				const key = document.createElement("i");
				key.className = "tfig__line-key";
				key.setAttribute("aria-hidden", "true");
				const name = document.createElement("span");
				name.className = "tfig__key-name";
				name.textContent = country?.name ?? iso;
				const val = document.createElement("span");
				val.className = "tfig__key-value num";
				fillValue(val, value);
				const remove = document.createElement("button");
				remove.type = "button";
				remove.className = "tfig__key-remove";
				remove.dataset.tfigUnpin = iso;
				remove.setAttribute("aria-label", `Stop comparing ${country?.name ?? iso}`);
				remove.innerHTML =
					'<svg aria-hidden="true" viewBox="0 0 10 10"><path d="m2 2 6 6M8 2 2 8" stroke="currentColor" stroke-width="1.4"/></svg>';
				li.append(key, name, val, remove);
				return li;
			});
			const medianValue = medianSeries(measure.id)[yearIndex] ?? null;
			const medianItem = document.createElement("li");
			medianItem.className = "tfig__key tfig__key--median";
			medianItem.dataset.iso = "median";
			const medianKey = document.createElement("i");
			medianKey.className = "tfig__line-key";
			const medianName = document.createElement("span");
			medianName.className = "tfig__key-name";
			medianName.textContent = "Median";
			const medianCount = document.createElement("span");
			medianCount.className = "tfig__unit";
			medianCount.textContent = ` of ${countWithData(yearIndex)}`;
			medianName.append(medianCount);
			const medianVal = document.createElement("span");
			medianVal.className = "tfig__key-value num";
			fillValue(medianVal, medianValue);
			medianItem.append(medianKey, medianName, medianVal);
			const keyItem = (keyClass: string, text: string) => {
				const li = document.createElement("li");
				li.className = "tfig__key";
				const key = document.createElement("i");
				key.className = keyClass;
				key.setAttribute("aria-hidden", "true");
				const name = document.createElement("span");
				name.className = "tfig__key-name";
				name.textContent = text;
				li.append(key, name);
				return li;
			};
			const densityKeys = isDist()
				? [
						keyItem("tfig__area-key", `Density, ${years[yearIndex]}`),
						...(yearIndex > 0 ? [keyItem("tfig__outline-key", String(firstYear))] : []),
					]
				: [];
			const convergenceKeys: HTMLElement[] = [];
			const benchmark = measure.benchmark;
			if (benchmark && measure.form === "gap") {
				convergenceKeys.push(keyItem("tfig__frontier-key", `${benchmarkLabel[benchmark]} = 100%`));
			}
			if (benchmark && isConv()) {
				const fit = convergenceFit(measure, convergencePoints(measure, yearIndex));
				if (fit) {
					const size = Math.abs(fit.perDoubling).toFixed(2);
					const direction = fit.perDoubling <= 0 ? "slower" : "faster";
					convergenceKeys.push(
						keyItem(
							"tfig__fit-key",
							`Fitted line: catch-up ${size} points ${direction} per doubling of relative income (R² ${fit.r2.toFixed(2)})`,
						),
					);
				}
				const before = medianRelativeIncome(benchmark, yearIndex);
				const after = medianRelativeIncome(benchmark, years.length - 1);
				if (before != null && after != null) {
					convergenceKeys.push(
						keyItem(
							"tfig__spread-key",
							`Median economy: ${Math.round(before)}% of ${benchmarkLabel[benchmark]} in ${years[yearIndex]}, ${Math.round(after)}% in ${lastYear}`,
						),
					);
				}
			}
			els.keys.replaceChildren(...items, medianItem, ...densityKeys, ...convergenceKeys);
		};

		/* ---------- distribution: one dot per economy, placed so none overlap ---------- */
		const swarmDots = new Map<string, HTMLElement>();
		const swarmLabels = new Map<string, HTMLElement>();
		let swarmLayout = new Map<string, { x: number; y: number }>();
		let swarmRadius = 6;

		const ensureSwarm = () => {
			if (!els.swarm || swarmDots.size > 0) return;
			for (const country of countries) {
				const dot = document.createElement("i");
				dot.dataset.iso = country.iso3;
				dot.classList.add("is-missing");
				els.swarm.append(dot);
				swarmDots.set(country.iso3, dot);
			}
		};

		/** Stack dots upward from the baseline; shrink them if a crowded year would overflow. */
		const layoutSwarm = (yearIndex: number) => {
			const width = els.canvas?.clientWidth ?? 0;
			const height = els.canvas?.clientHeight ?? 0;
			if (isConv()) {
				// Scatter: both coordinates are data, so no stacking.
				swarmRadius = width < 520 ? 5 : 7;
				swarmLayout = new Map(
					convergencePoints(m(), yearIndex).map((point) => [
						point.iso3,
						{ x: point.x * width, y: point.y * height },
					]),
				);
				return;
			}
			const points = distributionValues(m(), yearIndex);
			for (let radius = width < 520 ? 5 : 7; ; radius -= 0.5) {
				const spacing = 2 * radius + 1.5;
				const placed: { iso: string; x: number; y: number }[] = [];
				for (const point of points) {
					const x = point.pos * width;
					const near = placed.filter((other) => Math.abs(other.x - x) < spacing);
					const candidates = [
						radius,
						...near.map((other) => other.y + Math.sqrt(spacing ** 2 - (other.x - x) ** 2)),
					].sort((a, b) => a - b);
					const y =
						candidates.find((candidate) =>
							near.every(
								(other) => (other.x - x) ** 2 + (other.y - candidate) ** 2 >= spacing ** 2 - 0.01,
							),
						) ?? radius;
					placed.push({ iso: point.iso3, x, y });
				}
				const top = Math.max(0, ...placed.map((spot) => spot.y)) + radius;
				if (top <= height * 0.9 || radius <= 3) {
					swarmRadius = radius;
					swarmLayout = new Map(placed.map((spot) => [spot.iso, { x: spot.x, y: spot.y }]));
					return;
				}
			}
		};

		const renderSwarm = (yearIndex: number) => {
			if (!els.swarm) return;
			ensureSwarm();
			layoutSwarm(yearIndex);
			const width = els.canvas?.clientWidth || 1;
			const measure = m();
			els.swarm.style.setProperty("--r", `${swarmRadius}px`);
			els.swarm.dataset.ramp = measure.ramp;
			for (const [iso, dot] of swarmDots) {
				const spot = swarmLayout.get(iso);
				dot.classList.toggle("is-missing", !spot);
				// Each dot wears its tile's colour from the map.
				dot.dataset.bin = binFor(measure, valueAt(measure.id, iso, yearIndex));
				if (spot) {
					dot.style.left = pct(spot.x / width);
					dot.style.bottom = `${spot.y}px`;
				}
				const slot = state.slots.get(iso);
				if (slot) dot.dataset.slot = String(slot);
				else delete dot.dataset.slot;
			}
			for (const [iso, label] of swarmLabels) {
				if (state.slots.has(iso)) continue;
				label.remove();
				swarmLabels.delete(iso);
			}
			const placed: { bottom: number; x: number }[] = [];
			const pinnedSpots = state.pinned.flatMap((iso) => {
				const spot = swarmLayout.get(iso);
				return spot ? [{ iso, ...spot }] : [];
			});
			for (const iso of state.pinned) {
				let label = swarmLabels.get(iso);
				if (!label) {
					label = document.createElement("span");
					label.textContent = countryByIso.get(iso)?.name ?? iso;
					els.swarm.append(label);
					swarmLabels.set(iso, label);
				}
				const spot = swarmLayout.get(iso);
				label.hidden = !spot;
				if (!spot) continue;
				let bottom = spot.y + swarmRadius + 3;
				const half = label.offsetWidth / 2 || 40;
				const height = label.offsetHeight || 16;
				// Nudge a label up while it would sit on another label or another pinned dot.
				const blocked = (at: number) =>
					placed.some(
						(other) => Math.abs(other.x - spot.x) < 80 && Math.abs(other.bottom - at) < 15,
					) ||
					pinnedSpots.some(
						(other) =>
							other.iso !== iso &&
							Math.abs(other.x - spot.x) < half + swarmRadius &&
							other.y + swarmRadius > at &&
							other.y - swarmRadius < at + height,
					);
				while (blocked(bottom)) bottom += 16;
				placed.push({ bottom, x: spot.x });
				label.style.left = pct(spot.x / width);
				label.style.bottom = `${bottom}px`;
			}
		};

		const renderConvergence = (yearIndex: number) => {
			const fit = convergenceFit(m(), convergencePoints(m(), yearIndex));
			if (els.fit) {
				els.fit.style.display = fit ? "" : "none";
				if (fit) {
					els.fit.setAttribute("x1", fit.line.x1.toFixed(1));
					els.fit.setAttribute("x2", fit.line.x2.toFixed(1));
					els.fit.setAttribute("y1", fit.line.y1.toFixed(1));
					els.fit.setAttribute("y2", fit.line.y2.toFixed(1));
				}
			}
			renderSwarm(yearIndex);
		};

		const renderDistribution = (yearIndex: number) => {
			const measure = m();
			els.densityNow?.setAttribute("d", densityPath(measure, yearIndex, true));
			els.densityBase?.setAttribute("d", yearIndex > 0 ? densityPath(measure, 0, false) : "");
			const median = medianSeries(measure.id)[yearIndex] ?? null;
			if (els.distMedian) {
				els.distMedian.hidden = median == null;
				if (median != null) {
					const pos = position(measure, median);
					els.distMedian.style.left = pct(pos);
					els.distMedian.classList.toggle("is-flipped", pos > 0.75);
					if (els.distMedianLabel) {
						els.distMedianLabel.textContent = `Median ${measure.format(median)}`;
					}
				}
			}
			renderSwarm(yearIndex);
		};

		const renderEndLabels = () => {
			if (!els.labels) return;
			const measure = m();
			const series = seriesFor(measure.id);
			const median = medianSeries(measure.id);
			const candidates = [
				...state.pinned.map((iso) => ({
					key: iso,
					label: countryByIso.get(iso)?.name ?? iso,
					series: series[iso] ?? [],
					slot: state.slots.get(iso) ?? 0,
				})),
				{ key: "median", label: "Median", series: median, slot: 0 },
			];
			const labelled = candidates.flatMap((candidate) => {
				const value = candidate.series[lastIndexWithValue(candidate.series)];
				return value == null ? [] : [{ ...candidate, pos: position(measure, value) }];
			});
			// Converging lines: nudge the labels apart, about one label height (18px) each.
			const gap = Math.min(0.2, 18 / Math.max(1, els.labels.clientHeight));
			const spread = spreadLabels(
				labelled.map((label) => label.pos),
				gap,
			);
			const spans = labelled.map((label, index) => {
				const span = document.createElement("span");
				span.dataset.key = label.key;
				span.dataset.slot = String(label.slot);
				span.style.bottom = pct(spread[index] ?? label.pos);
				span.textContent = label.label;
				return span;
			});
			els.labels.replaceChildren(...spans);
		};

		const renderDots = (yearIndex: number) => {
			if (!els.dots) return;
			const measure = m();
			els.dots.replaceChildren(
				...state.pinned.flatMap((iso) => {
					const value = valueAt(measure.id, iso, yearIndex);
					if (value == null) return [];
					const dot = document.createElement("i");
					dot.dataset.slot = String(state.slots.get(iso) ?? 1);
					dot.style.left = pct(xPosition(yearIndex));
					dot.style.bottom = pct(position(measure, value));
					return [dot];
				}),
			);
		};

		const renderTiles = (yearIndex: number) => {
			const measure = m();
			const year = years[yearIndex];
			for (const [iso, tile] of tiles) {
				const value = valueAt(measure.id, iso, yearIndex);
				tile.dataset.bin = binFor(measure, value);
				const name = countryByIso.get(iso)?.name ?? iso;
				tile.setAttribute(
					"aria-label",
					`${name}: ${value == null ? "no data" : measure.format(value)} ${isConv() ? `from ${year} to ${lastYear}` : `in ${year}`}`,
				);
			}
			if (els.mapWhat) {
				els.mapWhat.textContent = isConv()
					? `Map shows growth relative to ${benchmarkPhrase[m().benchmark ?? DEFAULT_BENCHMARK]} from ${year} to ${lastYear}.`
					: `Map shows ${year}.`;
			}
		};

		const renderLegend = () => {
			const measure = m();
			if (els.tiles) els.tiles.dataset.ramp = measure.ramp;
			if (!els.legend) return;
			els.legend.dataset.ramp = measure.ramp;
			els.legend.replaceChildren(
				...[...measure.binLabels.map((label, bin) => [String(bin), label]), ["na", "No data"]].map(
					([bin, label]) => {
						const li = document.createElement("li");
						li.dataset.bin = bin;
						const swatch = document.createElement("i");
						swatch.setAttribute("aria-hidden", "true");
						const text = document.createElement("span");
						text.textContent = label ?? "";
						li.append(swatch, text);
						return li;
					},
				),
			);
		};

		const renderTable = () => {
			if (state.view !== "table" || !els.tableBody) return;
			const measure = m();
			const yearIndex = shownYear();
			const year = years[yearIndex];
			const series = seriesFor(measure.id);
			if (els.tableYear) els.tableYear.textContent = yearSpan(yearIndex);
			if (els.tableCaption) {
				els.tableCaption.textContent = `${measure.title} by economy, ${isConv() ? `${year} to ${lastYear}` : `in ${year}`}, sorted from highest to lowest`;
			}
			els.tableBody.replaceChildren(
				...tableRows(measure, yearIndex).map(({ country, value }) => {
					const tr = document.createElement("tr");
					const th = document.createElement("th");
					th.scope = "row";
					th.textContent = country.name;
					const region = document.createElement("td");
					region.className = "tfig__col-region";
					region.textContent = regionNames[country.region];
					const cell = document.createElement("td");
					cell.className = "num";
					cell.textContent = value == null ? "–" : measure.format(value);
					const trend = document.createElement("td");
					trend.className = "tfig__col-trend";
					const svg = document.createElementNS(svgNS, "svg");
					svg.setAttribute("viewBox", "0 0 100 24");
					svg.setAttribute("preserveAspectRatio", "none");
					svg.setAttribute("aria-hidden", "true");
					const path = document.createElementNS(svgNS, "path");
					// Sparklines always show income over time; the dot views' own values are not a time series.
					path.setAttribute(
						"d",
						usesDots()
							? sparkPath(measures.gdppc, seriesFor("gdppc")[country.iso3] ?? [])
							: sparkPath(measure, series[country.iso3] ?? []),
					);
					svg.append(path);
					trend.append(svg);
					tr.append(th, region, cell, trend);
					return tr;
				}),
			);
		};

		const renderHover = () => {
			const iso = state.hover?.iso ?? null;
			const measure = m();
			if (els.hover) {
				const pinned = iso ? state.pinned.includes(iso) : false;
				els.hover.setAttribute(
					"d",
					iso && !pinned && !usesDots() ? pathFor(measure, seriesFor(measure.id)[iso] ?? []) : "",
				);
			}
			for (const [tileIso, tile] of tiles) tile.classList.toggle("is-hovered", tileIso === iso);
			for (const [dotIso, dot] of swarmDots) dot.classList.toggle("is-hovered", dotIso === iso);
		};

		const renderTooltip = (anchor?: { x: number; y: number }) => {
			const tooltip = els.tooltip;
			if (!tooltip) return;
			const iso = state.hover?.iso;
			const yearIndex = shownYear();
			const value = iso ? valueAt(m().id, iso, yearIndex) : null;
			if (!iso || value == null || !anchor) {
				tooltip.hidden = true;
				return;
			}
			const strong = document.createElement("strong");
			strong.textContent = m().format(value);
			const label = document.createElement("span");
			const name = countryByIso.get(iso)?.name ?? iso;
			const benchmark = m().benchmark ?? DEFAULT_BENCHMARK;
			const startShare = isConv()
				? valueAt(convergenceMeasureId("gap", benchmark), iso, yearIndex)
				: null;
			label.textContent =
				startShare != null
					? `${name}, from ${Math.round(startShare)}% of ${benchmarkLabel[benchmark]} in ${years[yearIndex]}`
					: `${name}, ${years[yearIndex]}`;
			tooltip.replaceChildren(strong, label);
			tooltip.hidden = false;
			const flip = anchor.x > 0.7;
			tooltip.style.left = flip ? "" : `calc(${pct(anchor.x)} + 12px)`;
			tooltip.style.right = flip ? `calc(${pct(1 - anchor.x)} + 12px)` : "";
			tooltip.style.bottom = `calc(${pct(Math.min(0.92, anchor.y))} + 10px)`;
		};

		const renderYear = ({ cursor = true } = {}) => {
			const yearIndex = shownYear();
			const year = years[yearIndex] ?? lastYear;
			if (cursor && els.cursor && !usesDots()) els.cursor.style.left = pct(xPosition(yearIndex));
			if (els.range && document.activeElement !== els.range)
				els.range.value = String(years[state.yearIndex]);
			if (els.yearLabel)
				els.yearLabel.textContent = isConv() ? `${year}–${lastYear}` : String(year);
			if (isConv() && els.title) els.title.textContent = figureTitle(m(), yearIndex);
			renderKeys();
			if (isDist()) renderDistribution(yearIndex);
			else if (isConv()) renderConvergence(yearIndex);
			else renderDots(yearIndex);
			renderTiles(yearIndex);
			renderTable();
		};

		/** Marks which ends of the tab strip hide tabs, for the edge fades. */
		const markTabOverflow = () => {
			if (!tabStrip) return;
			const { clientWidth, scrollLeft, scrollWidth } = tabStrip;
			const start = scrollLeft > 1;
			const end = scrollLeft + clientWidth < scrollWidth - 1;
			if (start || end) tabStrip.dataset.overflow = start && end ? "both" : start ? "start" : "end";
			else delete tabStrip.dataset.overflow;
		};

		/** Scrolls the strip (never the page) so the selected tab clears the edge fades. */
		const keepTabInView = (tab: HTMLElement) => {
			if (!tabStrip || tabStrip.scrollWidth <= tabStrip.clientWidth) return;
			const strip = tabStrip.getBoundingClientRect();
			const box = tab.getBoundingClientRect();
			const fade = 40;
			let delta = 0;
			if (box.left < strip.left + fade) delta = box.left - strip.left - fade;
			else if (box.right > strip.right - fade) delta = box.right - strip.right + fade;
			if (delta) tabStrip.scrollBy({ behavior: reduceMotion() ? "auto" : "smooth", left: delta });
		};

		const renderMeasure = () => {
			const measure = m();
			root.dataset.kind = measure.kind;
			// Convergence starts at most ten years before the latest data.
			if (els.range) els.range.max = String(years[maxIndex()]);
			if (state.yearIndex > maxIndex()) {
				state.yearIndex = isConv()
					? Math.max(0, years.indexOf(DEFAULT_CONVERGENCE_START))
					: maxIndex();
			}
			if (els.title) els.title.textContent = figureTitle(measure, state.yearIndex);
			if (els.note) els.note.textContent = measure.note;
			if (els.source) els.source.textContent = sourceLine(measure);
			for (const tab of tabs) {
				const selected = tab.dataset.tfigTab === measure.tabId;
				tab.setAttribute("aria-selected", String(selected));
				tab.tabIndex = selected ? 0 : -1;
				if (selected) keepTabInView(tab);
			}
			if (sub) sub.hidden = measure.tabId !== "convergence";
			if (measure.form) state.form = measure.form;
			if (measure.benchmark) state.benchmark = measure.benchmark;
			for (const button of formButtons) {
				button.setAttribute("aria-pressed", String(button.dataset.tfigForm === state.form));
			}
			for (const button of benchmarkButtons) {
				button.setAttribute(
					"aria-pressed",
					String(button.dataset.tfigBenchmark === state.benchmark),
				);
			}
			renderAxes();
			renderLines();
			renderLegend();
			renderPinned();
			renderHover();
			renderYear();
			updatePlayLabel();
		};

		/* ---------- URL state (shareable views) ---------- */
		const writeUrl = () => {
			const params = new URLSearchParams(window.location.search);
			params.set("measure", state.measure);
			params.set("year", String(years[state.yearIndex]));
			params.set("compare", state.pinned.join(","));
			history.replaceState(
				null,
				"",
				`${window.location.pathname}?${params}${window.location.hash}`,
			);
		};

		const readUrl = () => {
			const params = new URLSearchParams(window.location.search);
			const measure = params.get("measure");
			if (!measure || !isMeasureId(measure)) return false;
			state.measure = measure;
			const yearIndex = years.indexOf(Number(params.get("year")));
			if (yearIndex >= 0) state.yearIndex = yearIndex;
			// An empty compare means the pins were cleared; no compare at all means the defaults.
			const compare = (params.get("compare") ?? DEFAULT_PINNED.join(","))
				.split(",")
				.filter((iso) => countryByIso.has(iso))
				.slice(0, MAX_PINNED);
			state.pinned = compare;
			state.slots = new Map(compare.map((iso, index) => [iso, index + 1]));
			return true;
		};

		/* ---------- interaction ---------- */
		const interact = () => {
			if (introRunning()) finishIntro();
		};

		const setMeasure = (id: MeasureId) => {
			interact();
			stopSweep();
			if (state.measure === id) return;
			// Stay on the latest year across tabs whose data ends in different years, and leave
			// catch-up (where the slider picks a start year) for the latest year too.
			const toLatest = isConv() || state.yearIndex === maxIndex();
			state.measure = id;
			if (toLatest && !isConv()) state.yearIndex = maxIndex();
			renderMeasure();
			writeUrl();
		};

		const setYearIndex = (index: number) => {
			interact();
			stopSweep();
			state.yearIndex = Math.min(maxIndex(), Math.max(0, index));
			state.hover = null;
			renderHover();
			renderYear();
			writeUrl();
		};

		const togglePin = (iso: string) => {
			interact();
			if (state.slots.has(iso)) {
				state.pinned = state.pinned.filter((item) => item !== iso);
				state.slots.delete(iso);
			} else {
				if (state.pinned.length >= MAX_PINNED) {
					const oldest = state.pinned.shift();
					if (oldest) state.slots.delete(oldest);
				}
				const used = new Set(state.slots.values());
				const slot = [1, 2, 3].find((candidate) => !used.has(candidate)) ?? 1;
				state.pinned.push(iso);
				state.slots.set(iso, slot);
			}
			renderPinned();
			renderHover();
			renderYear();
			writeUrl();
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener("click", () =>
				setMeasure(measureForTab(tab.dataset.tfigTab as TabId, state.form, state.benchmark)),
			);
			tab.addEventListener("keydown", (event) => {
				const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
				if (!step) return;
				event.preventDefault();
				const next = tabs[(index + step + tabs.length) % tabs.length];
				next?.focus();
				next?.click();
			});
		});

		for (const button of formButtons) {
			button.addEventListener("click", () => {
				state.form = button.dataset.tfigForm as ConvergenceForm;
				setMeasure(convergenceMeasureId(state.form, state.benchmark));
			});
		}

		for (const button of benchmarkButtons) {
			button.addEventListener("click", () => {
				state.benchmark = button.dataset.tfigBenchmark as BenchmarkId;
				setMeasure(convergenceMeasureId(state.form, state.benchmark));
			});
		}

		els.range?.addEventListener("input", () => {
			setYearIndex(years.indexOf(Number(els.range?.value)));
		});

		for (const [iso, tile] of tiles) {
			tile.addEventListener("click", () => togglePin(iso));
			const enter = () => {
				state.hover = { iso, yearIndex: state.yearIndex };
				renderHover();
			};
			const leave = () => {
				if (state.hover?.iso !== iso) return;
				state.hover = null;
				renderHover();
			};
			tile.addEventListener("pointerenter", enter);
			tile.addEventListener("focus", enter);
			tile.addEventListener("pointerleave", leave);
			tile.addEventListener("blur", leave);
		}

		els.keys?.addEventListener("click", (event) => {
			const button = (event.target as Element).closest<HTMLButtonElement>("[data-tfig-unpin]");
			if (button?.dataset.tfigUnpin) togglePin(button.dataset.tfigUnpin);
		});

		for (const button of viewButtons) {
			button.addEventListener("click", () => {
				state.view = button.dataset.tfigView === "table" ? "table" : "chart";
				for (const other of viewButtons) {
					other.setAttribute("aria-pressed", String(other === button));
				}
				if (els.chartView) els.chartView.hidden = state.view === "table";
				if (els.tableView) els.tableView.hidden = state.view !== "table";
				interact();
				renderTable();
			});
		}

		const pointerToData = (event: PointerEvent) => {
			const canvas = els.canvas;
			if (!canvas) return null;
			const rect = canvas.getBoundingClientRect();
			const fx = Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width));
			const fy = Math.min(1, Math.max(0, 1 - (event.clientY - rect.top) / rect.height));
			const yearIndex = Math.min(maxIndex(), Math.round(fx * (years.length - 1)));
			const measure = m();
			let best: string | null = null;
			let bestDistance = Number.POSITIVE_INFINITY;
			for (const country of countries) {
				const value = valueAt(measure.id, country.iso3, yearIndex);
				if (value == null) continue;
				const distance = Math.abs(position(measure, value) - fy);
				if (distance < bestDistance) {
					bestDistance = distance;
					best = country.iso3;
				}
			}
			const iso = bestDistance < 0.07 ? best : null;
			const value = iso ? valueAt(measure.id, iso, yearIndex) : null;
			return {
				iso,
				point: { x: xPosition(yearIndex), y: value == null ? fy : position(measure, value) },
				yearIndex,
			};
		};

		/** Nearest dot to the pointer in the distribution view, if it is close enough. */
		const pointerToDot = (event: PointerEvent) => {
			const canvas = els.canvas;
			if (!canvas) return { iso: null, point: undefined };
			const rect = canvas.getBoundingClientRect();
			const x = event.clientX - rect.left;
			const fromBottom = rect.bottom - event.clientY;
			let best: string | null = null;
			let bestDistance = Number.POSITIVE_INFINITY;
			for (const [iso, spot] of swarmLayout) {
				const distance = Math.hypot(spot.x - x, spot.y - fromBottom);
				if (distance < bestDistance) {
					bestDistance = distance;
					best = iso;
				}
			}
			const spot = best ? swarmLayout.get(best) : undefined;
			if (!best || !spot || bestDistance > Math.max(14, swarmRadius * 2.2)) {
				return { iso: null, point: undefined };
			}
			return { iso: best, point: { x: spot.x / rect.width, y: spot.y / rect.height } };
		};

		els.canvas?.addEventListener("pointermove", (event) => {
			if (introRunning()) return;
			if (usesDots()) {
				const hit = pointerToDot(event);
				state.hover = hit.iso ? { iso: hit.iso, yearIndex: state.yearIndex } : null;
				renderHover();
				renderTooltip(hit.point);
				return;
			}
			const hit = pointerToData(event);
			if (!hit) return;
			state.hover = { iso: hit.iso, yearIndex: hit.yearIndex };
			renderHover();
			renderYear();
			renderTooltip(hit.point);
		});

		els.canvas?.addEventListener("pointerdown", (event) => {
			interact();
			if (usesDots()) {
				const hit = pointerToDot(event);
				if (event.pointerType === "mouse") {
					if (hit.iso) togglePin(hit.iso);
					return;
				}
				state.hover = hit.iso ? { iso: hit.iso, yearIndex: state.yearIndex } : null;
				renderHover();
				renderTooltip(hit.point);
				return;
			}
			const hit = pointerToData(event);
			if (!hit) return;
			if (event.pointerType !== "mouse") {
				state.yearIndex = hit.yearIndex;
				state.hover = { iso: hit.iso, yearIndex: hit.yearIndex };
				renderHover();
				renderYear();
				renderTooltip(hit.point);
			} else if (hit.iso) {
				togglePin(hit.iso);
			}
		});

		els.canvas?.addEventListener("pointerleave", (event) => {
			if (event.pointerType !== "mouse") return;
			state.hover = null;
			renderHover();
			renderYear();
			renderTooltip();
		});

		root.addEventListener("keydown", (event) => {
			const target = event.target as HTMLElement;
			if (target === els.range || event.metaKey || event.ctrlKey || event.altKey) return;
			const digit = Number(event.key);
			if (digit >= 1 && digit <= tabOrder.length) {
				event.preventDefault();
				setMeasure(measureForTab(tabOrder[digit - 1] as TabId, state.form, state.benchmark));
				return;
			}
			if (target.getAttribute("role") === "tab") return;
			if (event.key === "ArrowLeft" || event.key === "ArrowRight") {
				event.preventDefault();
				setYearIndex(state.yearIndex + (event.key === "ArrowRight" ? 1 : -1));
			}
		});

		// Dot stacking depends on the plot's pixel size, so lay it out again on resize.
		let resizeFrame = 0;
		if (els.canvas && "ResizeObserver" in window) {
			new ResizeObserver(() => {
				window.cancelAnimationFrame(resizeFrame);
				resizeFrame = window.requestAnimationFrame(() =>
					usesDots() ? renderSwarm(shownYear()) : renderEndLabels(),
				);
			}).observe(els.canvas);
		}
		if (tabStrip) {
			tabStrip.addEventListener("scroll", markTabOverflow, { passive: true });
			if ("ResizeObserver" in window) new ResizeObserver(markTabOverflow).observe(tabStrip);
		}

		/* ---------- start ---------- */
		if (readUrl()) {
			root.classList.remove("is-intro", "is-playing");
			renderMeasure();
		} else if (root.classList.contains("is-intro")) {
			introFrame = window.requestAnimationFrame(syncIntro);
		}
		updatePlayLabel();
	}
</script>
