---
import AboutFacts from "@/components/about/AboutFacts.astro";
import LitText from "@/components/about/LitText.astro";
import Portrait from "@/components/about/Portrait.astro";
import PageHead from "@/components/site/PageHead.astro";
import Site from "@/layouts/Site.astro";
import { contact, siteFeatures } from "@/site.config";

const sections = [
	{ id: "work", title: "Work" },
	{ id: "education", title: "Education" },
	{ id: "interests", title: "Interests" },
	{ id: "elsewhere", title: "Elsewhere" },
];
---

<Site
	meta={{
		description:
			"Anton Grahed, Research Analyst at the EBRD. Background, education, and research interests.",
		title: "About",
	}}
	section="About"
>
	<PageHead
		lead="Research Analyst in the Office of the Chief Economist at the European Bank for Reconstruction and Development. BSc and MSc in Economics from the London School of Economics."
		title="About"
	/>

	<section class="section about-page">
		<div class="wrap about-page__grid">
			<aside class="about-page__side">
				<div class="about-page__portrait">
					<Portrait loading="eager" sizes="(min-width: 64rem) 20rem, calc(100vw - 2rem)" />
				</div>
				<nav aria-label="On this page" class="about-page__toc">
					<ol role="list">
						{
							sections.map((section) => (
								<li>
									<a href={`#${section.id}`}>{section.title}</a>
								</li>
							))
						}
					</ol>
				</nav>
			</aside>

			<div class="prose about-page__prose">
				<LitText
					class="about-page__intro"
					text="Hi! My name is Anton Grahed. I’m a Research Analyst in the Office of the Chief Economist at the EBRD, and before that I did my BSc and MSc in Economics at the LSE."
				/>

				<AboutFacts />

				<h2 data-section="Work" id="work">Work</h2>
				<p>
					As a Research Analyst in the Office of the Chief Economist, I support the Bank’s applied
					research on development economics and growth, mostly through the data work and
					visualisation behind it. My open-source tools for working with economic data are under
					<a href="/projects/">Projects</a>.
				</p>

				<h2 data-section="Education" id="education">Education</h2>
				<p>
					I did my BSc and MSc in Economics at the London School of Economics and Political Science.
				</p>

				<h2 data-section="Interests" id="interests">Interests</h2>
				<p>
					I have broad interests across economics, but I’m especially drawn to twentieth-century
					economic history, the causes and conditions for growth, international economics,
					migration, the Nordic model, and how communism shaped Eastern Europe’s later development.
				</p>

				<h2 data-section="Elsewhere" id="elsewhere">Elsewhere</h2>
				{
					siteFeatures.stamps ? (
						<p>
							Outside work I shoot 35mm film, mostly on a Nikon F5, Nikon FA, Nikon FM2N and an
							Olympus Mju II, and collect stamps. Both are documented on this site, under{" "}
							<a href="/film/">Film</a>
							and <a href="/stamps/">Stamps</a>.
						</p>
					) : (
						<p>
							Outside work I shoot 35mm film, mostly on a Nikon F5, Nikon FA, Nikon FM2N and an
							Olympus Mju II. The photographs are in the <a href="/film/">film archive</a>.
						</p>
					)
				}
				<p>
					You can reach me at <a href={`mailto:${contact.email}`}>{contact.email}</a> or find my code
					on
					<a href={contact.github} rel="noreferrer">GitHub</a>.
				</p>
			</div>
		</div>
	</section>
</Site>

<style>
	.about-page {
		padding-top: clamp(2.5rem, 6vw, 4rem);
	}

	.about-page__grid {
		display: grid;
		gap: 2.5rem clamp(2rem, 6vw, 6rem);
	}

	.about-page__portrait {
		max-width: 20rem;
		margin: 0;
	}

	.about-page__toc {
		display: none;
	}

	.about-page__prose :global(.about-page__intro) {
		color: var(--ink);
		font-size: var(--step-1);
		line-height: 1.55;
	}

	.about-page__prose :global(.about-facts) {
		margin-block: 2rem 0.5rem;
	}

	.about-page__prose h2:first-of-type {
		margin-top: 2.5rem;
	}

	@media (min-width: 56rem) {
		.about-page__grid {
			grid-template-columns: minmax(14rem, 20rem) minmax(0, 1fr);
		}

		.about-page__side {
			position: sticky;
			top: calc(var(--header-h) + 2rem);
			align-self: start;
		}

		.about-page__toc {
			display: block;
			margin-top: 2rem;
			border-top: 1px solid var(--rule);
		}

		.about-page__toc a {
			display: block;
			padding: 0.55rem 0;
			border-bottom: 1px solid var(--rule);
			color: var(--ink-2);
			font-size: 0.9375rem;
			text-decoration: none;
		}

		.about-page__toc a:hover {
			color: var(--ink);
		}
	}
</style>
