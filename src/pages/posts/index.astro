---
import { Icon } from "astro-icon/components";
import FormattedDate from "@/components/FormattedDate.astro";
import { getAllPosts, groupPostsByYear } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const meta = {
	description:
		"Writing on economics, growth, and the things I'm reading and building.",
	title: "Posts",
};

const allPosts = (await getAllPosts()).sort(collectionDateSort);
const groupedByYear = groupPostsByYear(allPosts);
const descYearKeys = Object.keys(groupedByYear).sort((a, b) => +b - +a);
---

<PageLayout meta={meta}>
	<section class="border-border border-b">
		<div class="shell py-16 md:py-24">
			<p class="eyebrow reveal">Posts</p>
			<h1 class="title reveal mt-4 [animation-delay:80ms]">Writing</h1>
			<p class="lead reveal text-text-secondary mt-6 max-w-[40rem] [animation-delay:160ms]">
				Notes on economics, growth, and the things I'm reading and building.
			</p>
			<a
				class="btn-ghost reveal mt-8 [animation-delay:240ms]"
				href="/rss.xml"
				rel="noreferrer"
				target="_blank"
			>
				RSS feed
				<Icon aria-hidden="true" class="h-5 w-5" focusable="false" name="mdi:rss" />
			</a>
		</div>
	</section>

	<section class="bg-surface">
		<div class="shell py-16 md:py-24">
			{
				allPosts.length === 0 ? (
					<div class="border-border text-text-secondary flex min-h-64 flex-col justify-center border p-8">
						<p class="eyebrow">Coming soon</p>
						<p class="mt-3 max-w-[40rem] text-sm">
							The first posts are on their way. In the meantime, you can follow along via the{" "}
							<a class="text-link" href="/rss.xml">
								RSS feed
							</a>
							.
						</p>
					</div>
				) : (
					descYearKeys.map((yearKey) => (
						<section class="mb-16 last:mb-0">
							<p class="eyebrow">{yearKey}</p>
							<ul class="bg-border mt-6 grid gap-px">
								{groupedByYear[yearKey]?.map((post) => (
									<li>
										<a
											class="group bg-global-bg hover:bg-surface-hover ease-productive flex flex-col gap-4 p-6 transition-colors duration-100 sm:flex-row sm:items-baseline sm:gap-8"
											href={`/posts/${post.id}/`}
										>
											<FormattedDate
												class="text-text-secondary min-w-32 shrink-0 pt-1 font-mono text-xs tracking-[0.1em] uppercase"
												date={post.data.publishDate}
											/>
											<div class="min-w-0 flex-1">
												<p class="text-xl">
													{post.data.draft && (
														<span class="text-error font-mono text-xs uppercase">(Draft) </span>
													)}
													{post.data.title}
												</p>
												<p class="text-text-secondary mt-2 line-clamp-2 text-sm">
													{post.data.description}
												</p>
											</div>
											<Icon
												aria-hidden="true"
												class="ease-productive group-hover:text-link mt-1 hidden h-5 w-5 shrink-0 transition-all duration-100 group-hover:translate-x-1 sm:block"
												focusable="false"
												name="mdi:arrow-right"
											/>
										</a>
									</li>
								))}
							</ul>
						</section>
					))
				)
			}
		</div>
	</section>
</PageLayout>
