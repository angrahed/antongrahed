---
import PostPreview from "@/components/blog/PostPreview.astro";
import PageHead from "@/components/site/PageHead.astro";
import { getAllPosts, groupPostsByYear } from "@/data/post";
import Site from "@/layouts/Site.astro";
import { siteFeatures } from "@/site.config";
import { collectionDateSort } from "@/utils/date";

if (!siteFeatures.posts) return Astro.redirect("/");

const allPosts = (await getAllPosts()).sort(collectionDateSort);
const grouped = groupPostsByYear(allPosts);
const yearKeys = Object.keys(grouped).sort((a, b) => Number(b) - Number(a));
---

<Site
	meta={{
		description: "Writing on economics, growth, and the things I'm reading and building.",
		title: "Writing",
	}}
	section="Writing"
>
	<PageHead
		lead="Notes on economics, growth, and the things I'm reading and building."
		title="Writing"
	>
		<p class="writing-feed">
			<a class="text-link" href="/rss.xml">Subscribe with RSS</a> or browse <a
				class="text-link"
				href="/tags/">tags</a
			>.
		</p>
	</PageHead>
	<section class="section writing">
		<div class="wrap">
			{
				allPosts.length === 0 ? (
					<p class="muted">The first posts are on their way.</p>
				) : (
					yearKeys.map((year) => (
						<section aria-labelledby={`year-${year}`} class="writing__year">
							<h2 class="writing__year-title num" id={`year-${year}`}>
								{year}
							</h2>
							{grouped[year]?.map((post) => (
								<PostPreview headingLevel="h3" post={post} />
							))}
						</section>
					))
				)
			}
		</div>
	</section>
</Site>

<style>
	.writing-feed {
		margin-top: 1.25rem;
		color: var(--ink-2);
	}

	.writing {
		padding-top: clamp(2rem, 5vw, 3rem);
	}

	.writing__year + .writing__year {
		margin-top: 3rem;
	}

	.writing__year-title {
		margin-bottom: 0.75rem;
		color: var(--ink-3);
		font-size: var(--step-0);
		font-weight: 500;
	}
</style>
