---
import FilmArchive from "@/components/film/FilmArchive.astro";
import PageHead from "@/components/site/PageHead.astro";
import Site from "@/layouts/Site.astro";
---

<Site
	meta={{
		canonicalPath: "/film/",
		description: "A rolling archive of Anton Grahed's 35mm film photography.",
		title: "Film",
	}}
	section="Film"
>
	<PageHead
		lead="A rolling selection from my negatives. Near and far, mostly on a Nikon F5, Nikon FA, Nikon FM2N and an Olympus Mju II."
		title="Film"
	/>
	<section class="section film-page">
		<div class="wrap">
			<FilmArchive />
		</div>
	</section>
</Site>

<style>
	.film-page {
		padding-top: clamp(2rem, 5vw, 3rem);
	}
</style>
