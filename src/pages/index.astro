---
import { Image } from "astro:assets";
import AboutFacts from "@/components/about/AboutFacts.astro";
import InterestRotator from "@/components/about/InterestRotator.astro";
import LitText from "@/components/about/LitText.astro";
import Portrait from "@/components/about/Portrait.astro";
import FilmStrip from "@/components/film/FilmStrip.astro";
import TransitionFigure from "@/components/home/TransitionFigure.astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import { bookItems } from "@/data/books";
import { featuredStamps } from "@/data/stamps";
import Site from "@/layouts/Site.astro";
import { getFilmFrames, getFilmPlaces } from "@/lib/film";
import { projects } from "@/lib/projects";
import { contact, siteFeatures } from "@/site.config";

const frames = await getFilmFrames();
const places = getFilmPlaces(frames);
---

<Site
	meta={{
		description:
			"Anton Grahed, Research Analyst in the Office of the Chief Economist at the EBRD. Economic growth, development and the legacy of communism.",
	}}
>
	<section class="hero" data-section="Home">
		<div class="wrap">
			<div class="hero__intro">
				<h1 class="display hero__title">Working on the economics of transition.</h1>
				<div class="hero__aside">
					<p class="lead">
						Hi, I’m Anton Grahed. I research economic growth, development, and the economic legacy
						of communism at the European Bank for Reconstruction and Development.
					</p>
					<div class="hero__actions">
						<a class="button button--primary" href="/about/">About me</a>
						<a class="button" href="/projects/">See projects</a>
					</div>
				</div>
			</div>
			<TransitionFigure />
		</div>
	</section>

	<section aria-labelledby="about-title" class="section" data-section="About" id="about">
		<div class="wrap about">
			<div class="about__portrait">
				<Portrait sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 18rem, calc(100vw - 2rem)" />
			</div>
			<div class="about__body">
				<h2 class="about__title" id="about-title">About</h2>
				<LitText
					class="about__lead"
					text="I’m a Research Analyst in the Office of the Chief Economist at the EBRD. I support the Bank’s applied research on development economics and growth, mostly through the data work and visualisation behind it."
				/>
				<InterestRotator />
				<AboutFacts />
				<a class="text-link about__more" href="/about/">Read the full profile</a>
			</div>
		</div>
	</section>

	<section aria-labelledby="projects-title" class="section" data-section="Projects" id="projects">
		<div class="wrap">
			<div class="section-head">
				<h2 id="projects-title">Projects</h2>
				<p>
					Research tools and data explorations, mostly built around economic data. Each is open
					source on GitHub.
				</p>
			</div>
			<div class="project-grid">
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>
		</div>
	</section>

	<section aria-labelledby="film-title" class="section" data-section="Film" id="film">
		<div class="wrap">
			<div class="section-head">
				<h2 id="film-title">Film</h2>
				<p>
					A rolling selection from {frames.length} frames shot on 35mm in {places.length} places, mostly
					on a Nikon F5, Nikon FA, Nikon FM2N and an Olympus Mju II.
				</p>
			</div>
			<FilmStrip />
			<p class="film-more"><a class="text-link" href="/film/">Open the film archive</a></p>
		</div>
	</section>

	{
		siteFeatures.stamps && (
			<section aria-labelledby="stamps-title" class="section" data-section="Stamps" id="stamps">
				<div class="wrap">
					<div class="section-head">
						<h2 id="stamps-title">Stamps</h2>
						<p>A few favourites from my postage stamp collection.</p>
					</div>
					<ul class="stamp-teaser" role="list">
						{featuredStamps.map((stamp) => (
							<li>
								<a href={`/stamps/#${stamp.id}`}>
									<Image
										alt={stamp.alt}
										decoding="async"
										loading="lazy"
										quality={82}
										sizes="(min-width: 52rem) 22vw, 45vw"
										src={stamp.src}
										widths={[240, 360, 480]}
									/>
									<span>{stamp.caption}</span>
								</a>
							</li>
						))}
					</ul>
					<p class="film-more">
						<a class="text-link" href="/stamps/">
							See the whole collection
						</a>
					</p>
				</div>
			</section>
		)
	}

	{
		siteFeatures.books && (
			<section aria-labelledby="books-title" class="section" data-section="Books" id="books">
				<div class="wrap">
					<div class="section-head">
						<h2 id="books-title">Favourite books</h2>
						<p>Books I’ve liked and would recommend.</p>
					</div>
					{bookItems.length === 0 ? (
						<p class="muted">The list is coming soon.</p>
					) : (
						<ol class="books" role="list">
							{bookItems.map((book) => (
								<li id={book.id}>
									<p class="books__title">
										{book.url ? <a href={book.url}>{book.title}</a> : book.title}
									</p>
									<p class="meta">
										{book.author}
										{book.firstPublished !== undefined && `, ${book.firstPublished}`}
									</p>
									<p class="muted">{book.note}</p>
								</li>
							))}
						</ol>
					)}
				</div>
			</section>
		)
	}

	<section
		aria-labelledby="contact-title"
		class="section contact"
		data-section="Contact"
		id="contact"
	>
		<div class="wrap contact__inner">
			<h2 class="contact__title" id="contact-title">Get in touch</h2>
			<div class="contact__body">
				<p class="lead">
					Email is the quickest way to reach me. The code for the projects is on GitHub.
				</p>
				<div class="contact__actions">
					<a class="button button--primary" href={`mailto:${contact.email}`}
						>Email {contact.email}</a
					>
					<a class="button" href={contact.github} rel="noreferrer">GitHub</a>
				</div>
			</div>
		</div>
	</section>
</Site>

<style>
	.hero {
		padding-block: clamp(2rem, 4vw, 3.25rem) clamp(4rem, 8vw, 6.5rem);
	}

	.hero__intro {
		display: grid;
		gap: 1.5rem 3rem;
		margin-bottom: clamp(2rem, 4vw, 2.75rem);
	}

	.hero__title {
		max-width: 13ch;
	}

	.hero__aside {
		max-width: 34rem;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.5rem;
	}

	@media (min-width: 60rem) {
		.hero__intro {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
			align-items: end;
		}
	}

	/* About */
	.about {
		display: grid;
		gap: 2rem clamp(2rem, 5vw, 4.5rem);
	}

	.about__portrait {
		max-width: 22rem;
	}

	.about__body {
		display: grid;
		min-width: 0;
		align-content: start;
		gap: clamp(1.75rem, 3.5vw, 2.5rem);
	}

	.about__title {
		margin-bottom: -0.75rem;
		font-size: var(--step-4);
		font-weight: 360;
		letter-spacing: -0.03em;
	}

	.about__body :global(.about__lead) {
		max-width: 40rem;
		color: var(--ink);
		font-size: var(--step-3);
		font-weight: 320;
		line-height: 1.32;
		letter-spacing: -0.02em;
	}

	.about__more {
		justify-self: start;
	}

	@media (min-width: 52rem) {
		.about {
			grid-template-columns: minmax(14rem, 22rem) minmax(0, 1fr);
			align-items: start;
		}

		.about__portrait {
			position: sticky;
			top: calc(var(--header-h) + 2rem);
		}
	}

	/* Projects */
	.project-grid {
		display: grid;
		gap: 1px;
		border: 1px solid var(--rule);
		background: var(--rule);
	}

	@media (min-width: 52rem) {
		.project-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Film */
	.film-more {
		margin-top: 1.5rem;
	}

	/* Stamps */
	.stamp-teaser {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
	}

	.stamp-teaser a {
		display: grid;
		gap: 0.5rem;
		color: var(--ink-2);
		font-size: var(--step--1);
		text-decoration: none;
	}

	.stamp-teaser :global(img) {
		width: 100%;
		height: auto;
		aspect-ratio: 5 / 4;
		padding: 0.75rem;
		border: 1px solid var(--rule);
		background: var(--surface);
		object-fit: contain;
	}

	.stamp-teaser a:hover :global(img) {
		border-color: var(--signal);
	}

	@media (min-width: 52rem) {
		.stamp-teaser {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}

	/* Books */
	.books {
		display: grid;
		gap: 1.5rem;
	}

	.books__title {
		font-size: var(--step-1);
	}

	/* Contact */
	.contact__inner {
		display: grid;
		gap: 1.5rem 3rem;
	}

	.contact__title {
		font-size: var(--step-4);
		font-weight: 360;
		letter-spacing: -0.03em;
	}

	.contact__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 1.5rem;
	}

	@media (min-width: 52rem) {
		.contact__inner {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			align-items: start;
		}
	}
</style>
