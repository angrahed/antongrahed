---
import Site from "@/layouts/Site.astro";
---

<Site
	meta={{ description: "This page could not be found.", title: "Page not found" }}
	section="Not found"
>
	<section class="not-found">
		<div class="wrap">
			<p class="not-found__code num" aria-hidden="true">404</p>
			<h1 class="display not-found__title">This page doesn’t exist.</h1>
			<p class="lead not-found__lead">
				The address may be mistyped, or the page may have moved. Search the site or start from the
				home page.
			</p>
			<div class="not-found__actions">
				<a class="button button--primary" href="/">Go to the home page</a>
				<button class="button" data-palette-open type="button">Search the site</button>
			</div>
		</div>
	</section>
</Site>

<style>
	.not-found {
		display: flex;
		min-height: calc(100svh - var(--header-h) - 18rem);
		align-items: center;
		padding-block: clamp(4rem, 10vw, 7rem);
	}

	.not-found__code {
		color: var(--signal);
		font-size: var(--step-1);
		font-weight: 500;
	}

	.not-found__title {
		max-width: 14ch;
		margin-top: 0.75rem;
	}

	.not-found__lead {
		max-width: 34rem;
		margin-top: 1.25rem;
	}

	.not-found__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 2rem;
	}
</style>
