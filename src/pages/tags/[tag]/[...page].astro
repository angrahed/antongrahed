---
import { render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import PageHead from "@/components/site/PageHead.astro";
import Paginator from "@/components/site/Paginator.astro";
import { getAllPosts, getTagMeta, getUniqueTags } from "@/data/post";
import Site from "@/layouts/Site.astro";
import { siteFeatures } from "@/site.config";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	if (!siteFeatures.posts) return [];
	const sortedPosts = (await getAllPosts()).sort(collectionDateSort);
	return getUniqueTags(sortedPosts).flatMap((tag) =>
		paginate(
			sortedPosts.filter((post) => post.data.tags.includes(tag)),
			{ pageSize: 10, params: { tag } },
		),
	);
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const { tag } = Astro.params;
const tagMeta = await getTagMeta(tag);
const TagContent = tagMeta ? (await render(tagMeta)).Content : null;
const title = tagMeta?.data.title ?? `Posts about ${tag}`;
---

<Site
	meta={{ description: tagMeta?.data.description ?? `Posts tagged ${tag}.`, title }}
	section="Writing"
>
	<PageHead
		crumbs={[
			{ href: "/posts/", label: "Writing" },
			{ href: "/tags/", label: "Tags" },
		]}
		title={title}
	>
		{
			(tagMeta?.data.description || TagContent) && (
				<div class="prose tag-intro">
					{tagMeta?.data.description && <p>{tagMeta.data.description}</p>}
					{TagContent && <TagContent />}
				</div>
			)
		}
	</PageHead>
	<section class="section">
		<div class="wrap">
			{page.data.map((post) => <PostPreview post={post} />)}
			<Paginator
				{...page.url.prev && { prevUrl: { text: "Newer posts", url: page.url.prev } }}
				{...page.url.next && { nextUrl: { text: "Older posts", url: page.url.next } }}
			/>
		</div>
	</section>
</Site>

<style>
	.tag-intro {
		margin-top: 1.25rem;
		color: var(--ink-2);
	}
</style>
