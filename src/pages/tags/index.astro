---
import PageHead from "@/components/site/PageHead.astro";
import { getAllPosts, getUniqueTagsWithCount } from "@/data/post";
import Site from "@/layouts/Site.astro";
import { siteFeatures } from "@/site.config";

if (!siteFeatures.posts) return Astro.redirect("/");

const allTags = getUniqueTagsWithCount(await getAllPosts());
---

<Site meta={{ description: "Every topic I've written about.", title: "Tags" }} section="Writing">
	<PageHead crumbs={[{ href: "/posts/", label: "Writing" }]} title="Tags" />
	<section class="section">
		<div class="wrap">
			<ul class="tag-list" role="list">
				{
					allTags.map(([tag, count]) => (
						<li>
							<a href={`/tags/${tag}/`}>{tag}</a>
							<span class="meta num">
								{count} {count === 1 ? "post" : "posts"}
							</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Site>

<style>
	.tag-list {
		max-width: 40rem;
	}

	.tag-list li {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 0.75rem;
		border-top: 1px solid var(--rule);
	}
</style>
