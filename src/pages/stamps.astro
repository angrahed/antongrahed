---
import PageHead from "@/components/site/PageHead.astro";
import StampGallery from "@/components/stamps/StampGallery.astro";
import Site from "@/layouts/Site.astro";
import { siteFeatures } from "@/site.config";

if (!siteFeatures.stamps) return Astro.redirect("/");
---

<Site
	meta={{
		canonicalPath: "/stamps/",
		description: "Anton Grahed's postage stamp collection.",
		title: "Stamps",
	}}
	section="Stamps"
>
	<PageHead lead="A collection of my favourite stamps. I add to it regularly." title="Stamps" />
	<StampGallery />
</Site>
