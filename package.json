{
	"name": "antongrahed",
	"type": "module",
	"version": "3.0.0",
	"private": false,
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro build",
		"postbuild": "pagefind --site dist",
		"preview": "astro preview",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check",
		"data:refresh": "node scripts/fetch-data.mjs",
		"data:basemap": "node scripts/generate-basemap.mjs",
		"verify:site": "node scripts/verify-site.mjs"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^6.3.2",
		"@astrojs/mdx": "4.3.0",
		"@astrojs/rss": "4.0.12",
		"@astrojs/sitemap": "3.4.1",
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/ibm-plex-sans": "^5.2.8",
		"@vercel/analytics": "^2.0.1",
		"astro": "5.10.1",
		"astro-expressive-code": "^0.41.2",
		"astro-robots-txt": "^1.0.0",
		"astro-webmanifest": "^1.0.0",
		"exif-reader": "^2.0.3",
		"hastscript": "^9.0.0",
		"mdast-util-directive": "^3.0.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^4.0.0",
		"satori": "0.15.2",
		"satori-html": "^0.3.2",
		"sharp": "^0.34.2",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.0.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.4",
		"@biomejs/biome": "^2.0.6",
		"@resvg/resvg-js": "^2.6.2",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"d3-geo": "^3.1.1",
		"opentype.js": "^2.0.0",
		"pagefind": "^1.3.0",
		"prettier": "^3.6.2",
		"prettier-plugin-astro": "0.14.1",
		"puppeteer-core": "^25.1.0",
		"reading-time": "^1.5.0",
		"topojson-client": "^3.1.0",
		"typescript": "^5.8.3",
		"world-atlas": "^2.0.2"
	},
	"pnpm": {
		"overrides": {
			"sharp": "^0.34.2"
		},
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"esbuild",
			"sharp"
		]
	}
}
